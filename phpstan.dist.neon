parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony: array shapes of the bundle configs, whose nested type aliases PHPStan does not resolve
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # Called by MicroKernelTrait to validate APP_ENV
        -
            identifier: method.unused
            path: src/Kernel.php
