# Default values for every environment. Committed: never put real secrets here.
#
# Load order (later files win), shared by Symfony AND Docker Compose (via the Makefile):
#   .env  <  .env.local  <  .env.$APP_ENV  <  .env.$APP_ENV.local
# Real environment variables always win over these files.
#
# Put your own values (URL, credentials, ports...) in .env.local (git-ignored).
# See doc/configuration.md for every variable.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> docker ###
COMPOSE_PROJECT_NAME=eplaneur
# Host name of the site (dev: needs a hosts entry + mkcert certificate, prod: public domain)
SERVER_NAME=eplaneur.local
# Host ports exposed in dev
HTTP_PORT=80
HTTPS_PORT=443
MARIADB_HOST_PORT=3307
MAILPIT_PORT=8025
PHP_VERSION=8.5
NGINX_VERSION=1.28
###< docker ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=https://${SERVER_NAME}
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Used by both the MariaDB container and Doctrine (config/packages/doctrine.yaml).
# Avoid "$" in passwords: Docker Compose would try to interpolate it.
MARIADB_VERSION=11.8
MARIADB_DATABASE=eplaneur
MARIADB_USER=eplaneur
MARIADB_PASSWORD=eplaneur
MARIADB_ROOT_PASSWORD=root
# Host/port seen from the PHP container (overridden by the container env)
DATABASE_HOST=database
DATABASE_PORT=3306
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Sender of every e-mail (account confirmation, password reset...)
MAILER_FROM="Club ePlaneur <no-reply@club.eplaneur.fr>"

# Comma-separated IPs/ranges of the reverse proxies allowed to set X-Forwarded-* headers
TRUSTED_PROXIES=127.0.0.1
