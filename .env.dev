# Development defaults (committed). Override them in .env.dev.local if needed:
# .env.dev wins over .env.local.

###> symfony/framework-bundle ###
APP_SECRET=8470f000627c5bcc85f0d6b45a51ceba
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Every e-mail is caught by Mailpit: http://localhost:8025
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> symfony/messenger ###
# Handle messages (e-mails included) synchronously, no worker needed in dev
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###
