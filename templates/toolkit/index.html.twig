{% extends 'base.html.twig' %}

{% block title %}Toolkit{% endblock %}

{#
    Living style guide: every toolkit component on every surface theme.
    Dev only (/_toolkit). Add each new component here.
#}
{% set colors = {
    'primary': '--color-primary', 'accent': '--color-accent', 'dark': '--color-dark',
    'tint-warm': '--color-tint-warm', 'tint-cool': '--color-tint-cool', 'paper': '--color-paper',
    'cream': '--palette-cream', 'slate': '--palette-slate', 'mist': '--palette-mist', 'line': '--palette-line',
} %}
{% block body %}
    <twig:Layout:Section theme="paper">
        <div class="l-stack l-stack--lg">
            <twig:Layout:SectionHeader eyebrow="Design system" title="Toolkit ePlaneur"
                lead="Tokens et composants réutilisables. Modifier un token dans assets/styles/tokens.css met à jour tout le site." />

            <twig:Ui:Heading level="2" size="h2">Couleurs</twig:Ui:Heading>
            <div class="l-grid l-grid--4 l-grid--tight u-full">
                {% for name, token in colors %}
                    <div class="c-card c-card--outlined">
                        <div style="height: 4rem; background: var({{ token }})"></div>
                        <div class="c-card__body"><strong>{{ name }}</strong><code class="u-note">{{ token }}</code></div>
                    </div>
                {% endfor %}
            </div>

            <twig:Ui:Heading level="2" size="h2">Typographie</twig:Ui:Heading>
            <div class="l-stack">
                <p class="c-display">Display</p>
                <p class="c-display c-display--sm">Display small</p>
                <twig:Ui:Heading level="3" size="h1">Heading h1 — Barlow</twig:Ui:Heading>
                <twig:Ui:Heading level="3" size="h2">Heading h2</twig:Ui:Heading>
                <twig:Ui:Heading level="3" size="h3">Heading h3</twig:Ui:Heading>
                <twig:Ui:Heading level="3" size="h4">Heading h4</twig:Ui:Heading>
                <p class="c-tagline">Tagline</p>
                <twig:Ui:Eyebrow>Eyebrow</twig:Ui:Eyebrow>
                <p class="u-lead">Lead — Inter 17px, interligne 1.65.</p>
                <p>Body — Inter 15px.</p>
                <p class="u-note">Note — Inter 13px.</p>
                <p class="c-motto">Motto between rules.</p>
            </div>
        </div>
    </twig:Layout:Section>

    {% for theme in ['light', 'paper', 'dark', 'primary', 'accent'] %}
        <twig:Layout:Section theme="{{ theme }}">
            <div class="l-stack l-stack--lg">
                <twig:Layout:SectionHeader eyebrow="Thème t-{{ theme }}" title="Composants sur fond {{ theme }}" lead="Les composants lisent les variables du thème de leur section.">
                    <twig:block name="aside"><twig:Ui:Link href="#">Lien de section</twig:Ui:Link></twig:block>
                </twig:Layout:SectionHeader>
                <div class="l-cluster">
                    <twig:Ui:Button>Primary</twig:Ui:Button>
                    <twig:Ui:Button variant="dark">Dark</twig:Ui:Button>
                    <twig:Ui:Button variant="accent">Accent</twig:Ui:Button>
                    <twig:Ui:Button variant="outline">Outline</twig:Ui:Button>
                    <twig:Ui:Button variant="primary" :icon="false">Sans icône</twig:Ui:Button>
                    <twig:Ui:Link href="#">Lien fléché</twig:Ui:Link>
                </div>
                <div class="l-cluster l-cluster--tight">
                    <twig:Ui:Tag>Default</twig:Ui:Tag>
                    <twig:Ui:Tag variant="muted">Muted</twig:Ui:Tag>
                    <twig:Ui:Tag variant="soft">Soft</twig:Ui:Tag>
                    <twig:Ui:Tag :pressed="true">Filtre actif</twig:Ui:Tag>
                    <twig:Ui:Tag :pressed="false">Filtre inactif</twig:Ui:Tag>
                    <twig:Ui:Badge>Badge</twig:Ui:Badge>
                    <twig:Ui:Badge size="small">Badge small</twig:Ui:Badge>
                </div>
                <div class="l-cluster">
                    <twig:Ui:Date day="08" :meta="['Oct.', '2026']" />
                    <twig:Ui:Profile icon="discover" title="Profile" text="Icône, titre et texte." />
                </div>
            </div>
        </twig:Layout:Section>
    {% endfor %}

    <twig:Layout:Section theme="light">
        <div class="l-stack l-stack--lg">
            <twig:Ui:Heading level="2" size="h2">Cartes</twig:Ui:Heading>
            <div class="l-grid l-grid--3 u-full">
                <twig:Card:Feature icon="discover" title="Feature warm" text="Carte teintée chaude." />
                <twig:Card:Feature icon="progress" tone="cool" title="Feature cool" text="Carte teintée froide." />
                <twig:Card:Step number="01" title="Step" text="Étape numérotée d’un parcours." linkLabel="Lien" />
            </div>
            <div class="l-rail">
                <twig:Card:Session day="08" month="Oct." year="2026" version="Condor 3" schedule="Jeudi · 20:30 · heure de Paris"
                    title="Session" level="Débutant" text="Carte de vol en réseau." />
                <twig:Card:News eyebrow="Rubrique" title="News avec image" text="Carte éditoriale." image="{{ asset('images/home/news-cockpit.jpg') }}" />
                <twig:Card:News featured poster="2025" posterLabel="Poster" eyebrow="À la une" title="News à la une" text="Variante mise en avant." />
            </div>
            <div class="l-grid l-grid--2 u-full">
                <twig:Card:Guide eyebrow="Guide" title="Guide" text="Carte avec chapitres."
                    :chapters="[{label: 'Chapitre un'}, {label: 'Chapitre deux'}]" ctaLabel="Action" />
                <div class="l-stack">
                    <twig:Ui:Figure src="{{ asset('images/home/cockpit.jpg') }}" badge="Badge sur image" caption="Légende de la figure" />
                    <twig:Ui:Dropzone title="Dropzone" hint="Zone de dépôt de fichier." />
                    <div class="l-grid l-grid--tight p-logbook__stats u-full">
                        <twig:Ui:Stat label="Distance" value="145,8" unit="km" />
                        <twig:Ui:Stat label="Durée" value="2 h 18" unit="en vol" />
                    </div>
                    <twig:Ui:Meter label="Meter highlight" value="96 %" :percent="96" highlight />
                    <twig:Ui:Meter label="Meter" value="60 %" :percent="60" />
                    <div class="c-callout u-full"><p class="u-note">Callout : message et action.</p><twig:Ui:Link href="#">Action</twig:Ui:Link></div>
                </div>
            </div>

            <twig:Ui:Heading level="2" size="h2">Formulaires</twig:Ui:Heading>
            <div class="l-grid l-grid--2 u-full">
                <div class="c-card c-card--raised t-paper">
                    <div class="c-card__body">
                        <div class="c-form">
                            <div class="c-field">
                                <label class="c-field__label" for="toolkit-email">Champ (.c-field, .c-input)</label>
                                <input class="c-input" id="toolkit-email" type="email" placeholder="nom@exemple.fr">
                                <p class="c-field__help">Aide (.c-field__help)</p>
                            </div>
                            <div class="c-field c-field--invalid">
                                <label class="c-field__label" for="toolkit-invalid">Champ en erreur (.c-field--invalid)</label>
                                <input class="c-input" id="toolkit-invalid" value="azerty" aria-invalid="true">
                                <ul class="c-field__errors" role="list"><li>Message d’erreur (.c-field__errors)</li></ul>
                            </div>
                            <label class="c-check"><input type="checkbox"><span>Case à cocher (.c-check)</span></label>
                            <twig:Ui:Button type="button" block>Bouton pleine largeur</twig:Ui:Button>
                        </div>
                    </div>
                </div>
                <div class="l-stack">
                    <div class="c-alert">Alerte neutre (.c-alert)</div>
                    <div class="c-alert c-alert--success">Succès (.c-alert--success)</div>
                    <div class="c-alert c-alert--error">Erreur (.c-alert--error)</div>
                    <dl class="c-definition-list">
                        <dt>Liste de définitions</dt>
                        <dd>.c-definition-list</dd>
                    </dl>
                </div>
            </div>

            <twig:Ui:Heading level="2" size="h2">Blocs de contenu</twig:Ui:Heading>
            <p class="u-lead u-full">Chaque type de bloc d’article (App\Content\Block\BlockType). Images, carrousel, vidéo, PDF et téléchargements : voir l’article de démonstration <a href="{{ path('app_post_show', {slug: 'votre-premier-vol'}) }}">Votre premier vol</a> (fixtures).</p>
            <div class="p-article__body u-full">
                <twig:Content:Blocks :blocks="blocks|filter(b => b.block.type.value != 'takeaways')" />
            </div>
        </div>
    </twig:Layout:Section>
    <twig:Content:Blocks :blocks="blocks|filter(b => b.block.type.value == 'takeaways')" />
    <twig:Layout:Section theme="light">
        <div class="l-stack l-stack--lg">
            <twig:Ui:Heading level="2" size="h2">Composants d’article</twig:Ui:Heading>
            <twig:Ui:Breadcrumb class="u-full" :items="[{label: 'Accueil', href: '#'}, {label: 'Rubrique', href: '#'}, {label: 'Page courante'}]" />
            <div class="l-grid l-grid--2 u-full">
                <twig:Content:Toc :entries="[{number: '01', title: 'Entrée du sommaire', anchor: 'toolkit-0'}, {number: '02', title: 'Autre entrée', anchor: 'toolkit-1'}]" />
                <div class="l-stack">
                    <twig:Content:Share url="https://club.eplaneur.fr" title="ePlaneur" />
                    <p class="l-cluster"><span class="c-level-badge">Badge de niveau</span><span class="c-keyword">Mot-clé</span><span class="c-avatar">CL</span></p>
                    <p class="u-note">À venir (non branchés, voir doc/roadmap.md) :</p>
                    <twig:Content:Comment initials="ML" author="Marc L." date="5 octobre 2026" text="Commentaire d’un lecteur." />
                    <twig:Content:Feedback question="Cet article vous a donné des repères ?" />
                </div>
            </div>
        </div>
    </twig:Layout:Section>
{% endblock %}
