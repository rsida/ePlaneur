{% extends 'base.html.twig' %}

{#
    Institutional page (Figma "Le Club — rubrique" and "Statuts — contenu niveau 3").
    A root page (section) spreads its blocks over the full width, without sidebar; a sub-page shows
    the pages of its section on the left, then the sidebar blocks, and its "Mis à jour" date.
#}
{% set page = view.page %}
{% set highlight = page.highlightSource %}
{% set section = page.parent is null %}
{% set crumbs = [{label: 'Accueil', href: path('app_home')}] %}
{% for ancestor in page.lineage %}
    {% set crumbs = crumbs|merge([{label: ancestor.title, href: path('app_page_show', {path: ancestor.path})}]) %}
{% endfor %}

{# Search settings (Référencement) first, then the content: doc/seo.md #}
{% block title %}{{ page.seoTitle ?: page.title }}{% endblock %}
{% block description %}{{ page.seoDescription ?: (page.excerpt ?: page.title)|u.truncate(160, '…', false) }}{% endblock %}
{% block og_image %}{{ page.seoImage ? absolute_url(image_url(page.seoImage, 'wide')) : parent() }}{% endblock %}
{# Indexed when online and public, as are the pages above it #}
{% block robots %}{{ not preview and not page.noIndex and page.lineage|filter(p => p.visibility.value != 'public')|length == 0 ? parent() : 'noindex, follow' }}{% endblock %}
{% block structured_data %}{{ json_ld([seo_breadcrumb(crumbs), ...seo_blocks(url('app_page_show', {path: page.path}), view.body, view.aside)]) }}{% endblock %}

{% block body %}
    {% if preview %}
        {# Preview from the editor: what is not on the site yet, the content or only its changes #}
        <p class="p-article__preview" role="status">
            {%- if page.online -%}
                Aperçu des modifications non enregistrées : la page en ligne n’a pas changé.
            {%- elseif page.published -%}
                Aperçu : cette page est publiée, mais une rubrique au-dessus d’elle ne l’est pas.
            {%- else -%}
                Aperçu : cette page n’est pas publiée.
            {%- endif -%}
        </p>
    {% endif %}

    <article class="p-page">
        <twig:Content:PageHeader
            :crumbs="crumbs"
            :kicker="page.kicker"
            :title="page.title"
            :lead="page.excerpt"
            :highlight="highlight ? highlight.highlight : null"
            :highlightNote="highlight ? highlight.highlightNote : null"
            :updatedAt="section ? null : page.updatedAt"
        />

        {% if section %}
            <div class="l-container p-page__body p-page__body--wide">
                <twig:Content:Blocks :blocks="view.body" />
                <twig:Content:Blocks :blocks="view.aside" />
            </div>
        {% else %}
            <div class="l-container p-page__layout">
                <aside class="p-page__sidebar">
                    {% if view.siblings|length > 1 %}
                        <nav class="c-subnav" aria-label="Pages de la rubrique {{ page.parent.title }}">
                            <p class="c-subnav__title">{{ page.parent.title }}</p>
                            <ul class="c-subnav__list" role="list">
                                {% for sibling in view.siblings %}
                                    <li>
                                        <a class="c-subnav__link" href="{{ path('app_page_show', {path: sibling.path}) }}"{% if sibling == page %} aria-current="page"{% endif %}>
                                            {{- sibling.title -}}
                                            {% if sibling.visibility.value != 'public' %}<twig:ux:icon name="lock-keyhole" class="c-subnav__lock" aria-label="réservé" />{% endif %}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </nav>
                    {% endif %}
                    <twig:Content:Blocks :blocks="view.aside" />
                </aside>

                <div class="p-article__body p-page__body">
                    <twig:Content:Blocks :blocks="view.body" />
                </div>
            </div>
        {% endif %}
    </article>
{% endblock %}
