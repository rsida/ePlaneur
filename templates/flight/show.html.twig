{% extends 'base.html.twig' %}

{% set analysis = flight.analysis %}
{% set stats = analysis.statistics %}
{% set task = analysis.task %}
{% set approx = analysis.exactTimes ? '' : ' (estimée)' %}

{% block title %}Vol de {{ flight.pilot }}{% endblock %}
{% block description %}Analyse du vol de {{ flight.pilot }}{% if flight.flightPlan %} : {{ flight.flightPlan }}{% endif %}.{% endblock %}

{% block body %}
    <section class="p-flight t-light" data-controller="flight-viewer"
             data-flight-viewer-url-value="{{ path('app_flight_analysis', {id: flight.id}) }}"
             data-flight-viewer-label-value="{{ flight.competitionId ?: flight.pilot }}">
        <div class="l-container p-flight__head">
            <div class="l-stack l-stack--sm">
                {% if app.user %}<twig:Ui:Link href="{{ path('app_flight_index') }}">Tous les vols</twig:Ui:Link>{% endif %}
                <twig:Ui:Eyebrow>Analyse de vol · {{ flight.simulator }}</twig:Ui:Eyebrow>
                <twig:Ui:Heading level="1" size="h2">{{ flight.pilot }}{% if flight.competitionId %} <span class="p-flight__cn">{{ flight.competitionId }}</span>{% endif %}</twig:Ui:Heading>
                <p class="p-flight__meta">
                    {{ [flight.glider, flight.landscape, flight.flightPlan, flight.flownOn ? flight.flownOn|format_date('long', locale: 'fr') : null]|filter(v => v)|join(' · ') }}
                </p>
                {% if flight.launch or flight.flightPlan or flight.owner or flight.public %}
                    <p class="p-flight__links">
                        {% if flight.launch %}<twig:Ui:Tag variant="soft" title="Lu sur le début de la trace">{{ flight.launch.label }}</twig:Ui:Tag>{% endif %}
                        {% if flight.public %}<twig:Ui:Tag title="Visible des visiteurs du site, sans les commentaires">Public</twig:Ui:Tag>{% endif %}
                        {% if flight.session %}<twig:Ui:Link href="{{ path('app_session_show', {id: flight.session.id}) }}">Session du {{ flight.session.date|format_date('long', locale: 'fr') }} · {{ flight.session.participantCount }} {{ flight.session.participantCount > 1 ? 'pilotes' : 'pilote' }}</twig:Ui:Link>{% endif %}
                        {% if flight.flightPlan and app.user %}<twig:Ui:Link href="{{ path('app_flight_session', {id: flight.id}) }}">{{ session_size > 1 ? session_size ~ ' traces sur ce plan de vol' : 'Ce plan de vol au club' }}</twig:Ui:Link>{% endif %}
                        {% if flight.owner and is_granted('LOGBOOK_VIEW', flight.owner) %}<twig:Ui:Link href="{{ flight.owner == app.user ? path('app_flight_logbook') : path('app_flight_logbook_pilot', {id: flight.owner.id}) }}">{{ flight.owner == app.user ? 'Mon carnet de vol' : 'Carnet de vol du pilote' }}</twig:Ui:Link>{% endif %}
                        {% if app.user and race and race.winner.id != flight.id and task and task.turnpoints[1].reached is not null %}<twig:Ui:Link href="{{ path('app_flight_compare', {id: flight.id, other: race.winner.id}) }}">Comparer au vainqueur</twig:Ui:Link>{% endif %}
                        {% if app.user and session_size > 1 and task and task.turnpoints[1].reached is not null %}<twig:Ui:Link href="{{ path('app_flight_compare_pick', {id: flight.id}) }}">Comparer avec un autre pilote</twig:Ui:Link>{% endif %}
                        {% if flight.owner and app.user and flight.owner != app.user and is_granted('MESSAGE_SEND') and flight.owner.hasPermission(enum('App\\Security\\Permission').MessageSend) %}<twig:Ui:Link href="{{ path('app_account_message_new', {a: flight.owner.id, vol: flight.id}) }}">Écrire au pilote</twig:Ui:Link>{% endif %}
                        {% if app.user and flight.fileName %}<twig:Ui:Link href="{{ path('app_flight_file', {id: flight.id}) }}" icon="download">Trace d’origine (.{{ flight.format }})</twig:Ui:Link>{% endif %}
                        {% if app.user %}<twig:Ui:Link href="{{ path('app_flight_igc', {id: flight.id}) }}" icon="download">Export IGC</twig:Ui:Link>{% endif %}
                    </p>
                {% endif %}
                {% for message in app.flashes('info') %}
                    <div class="c-alert" role="status">{{ message }}</div>
                {% endfor %}
                {% if not analysis.exactTimes %}
                    <p class="u-note">Les heures de cette trace n’ont pas pu être lues : les durées et les vitesses sont estimées (à quelques pourcents près). Les positions et altitudes sont exactes.</p>
                {% endif %}
            </div>
            {% if is_granted('FLIGHT_PUBLISH', flight) or is_granted('FLIGHT_DELETE', flight) %}
                <div class="p-flight__actions">
                    {% if is_granted('FLIGHT_PUBLISH', flight) %}
                        <form method="post" action="{{ path('app_flight_publish', {id: flight.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('publish_flight_' ~ flight.id) }}">
                            <input type="hidden" name="public" value="{{ flight.public ? '0' : '1' }}">
                            <twig:Ui:Button type="submit" variant="outline" size="sm" title="{{ flight.public ? 'Ne plus montrer ce vol aux visiteurs' : 'Montrer ce vol aux visiteurs du site, sans les commentaires' }}">{{ flight.public ? 'Rendre privé' : 'Rendre public' }}</twig:Ui:Button>
                        </form>
                    {% endif %}
                    {% if is_granted('FLIGHT_DELETE', flight) %}
                        <form method="post" action="{{ path('app_flight_delete', {id: flight.id}) }}" class="p-flight__delete"
                              onsubmit="return confirm('Supprimer ce vol ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_flight_' ~ flight.id) }}">
                            <twig:Ui:Button type="submit" variant="outline" size="sm" icon="trash">Supprimer</twig:Ui:Button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="l-container">
            <div class="p-flight__stats">
                <twig:Ui:Stat label="Durée{{ approx }}" value="{{ stats.duration|flight_duration }}" />
                <twig:Ui:Stat label="Distance parcourue" value="{{ stats.distance|flight_distance }}" />
                {% if task and task.completed %}
                    <twig:Ui:Stat label="Vitesse circuit{{ approx }}" value="{{ task.speed|number_format(1, ',', ' ') }}" unit="km/h sur {{ task.distance|flight_distance }}" />
                {% else %}
                    <twig:Ui:Stat label="Vitesse moyenne{{ approx }}" value="{{ stats.speedAverage|number_format(1, ',', ' ') }}" unit="km/h" />
                {% endif %}
                <twig:Ui:Stat label="Altitude max" value="{{ stats.altitudeMax|number_format(0, ',', ' ') }}" unit="m" />
                <twig:Ui:Stat label="Thermiques" value="{{ stats.thermals }}" unit="{{ stats.climbAverage is not null ? 'à ' ~ stats.climbAverage|number_format(1, ',', ' ') ~ ' m/s de moyenne' : '' }}" />
                <twig:Ui:Stat label="Temps en spirale" value="{{ stats.circlingShare is not null ? (stats.circlingShare * 100)|round ~ ' %' : '—' }}" unit="{{ stats.leftShare is not null ? (stats.leftShare * 100)|round ~ ' % à gauche' : '' }}" />
                <twig:Ui:Stat label="Finesse en transition" value="{{ stats.glideRatio is not null ? stats.glideRatio|number_format(0, ',', ' ') : '—' }}" unit="{{ stats.glideSpeed is not null ? 'à ' ~ stats.glideSpeed|number_format(0, ',', ' ') ~ ' km/h' : '' }}" />
            </div>
        </div>

        {# Details beyond the key figures (Condor Club parity, roadmap 7g1); older analyses lack them until analysed again #}
        {% set settings = flight.session ? flight.session.taskSettings : null %}
        {% set official = flight.session and flight.competitionId ? flight.session.results|filter(row => row.competitionId and row.competitionId|lower == flight.competitionId|lower)|first : null %}
        {% if stats.totalClimb is defined %}
            {% set final = task.finalGlide|default(null) %}
            {% set start = task ? task.turnpoints[1]|default(null) : null %}
            <div class="l-container p-flight__details">
                <section class="c-card c-card--outlined t-paper" aria-labelledby="details-title">
                    <div class="c-card__body l-stack l-stack--sm">
                        <twig:Ui:Heading level="2" size="h4" id="details-title">Le vol en détail</twig:Ui:Heading>
                        {% if official %}
                            <p class="p-flight__official">
                                <strong>Résultat officiel : {{ official.rank }}<sup>{{ official.rank == 1 ? 'er' : 'e' }}</sup> · {{ official.status|session_status }}</strong>
                                <span>{{ [official.time is not null ? official.time|flight_time : null, official.speed ? official.speed|number_format(1, ',', ' ') ~ ' km/h' : null, official.score is not null ? official.score|number_format(1, ',', ' ') ~ ' pts' : null]|filter(v => v)|join(' · ') }}{% if official.penalty %} · <span class="p-flight__alert">pénalités {{ official.penalty|number_format(0, ',', ' ') }} pts</span>{% endif %}</span>
                                {% if settings and settings.regatta %}<span class="u-note">Départ en régate : le temps officiel court depuis l’ouverture de la porte, pas depuis le passage de la ligne.</span>{% endif %}
                            </p>
                        {% endif %}
                        <dl class="p-flight__facts">
                            {% if start and start.reached is not null and settings %}
                                {% if settings.maxStartSpeed %}<div><dt>Vitesse sol au départ <span class="u-note">(maximum {{ settings.maxStartSpeed }} km/h ; mesurée sur 4 s, le serveur fait foi)</span></dt><dd>{{ start.reachedSpeed|number_format(0, ',', ' ') }} km/h</dd></div>{% endif %}
                                {% if settings.startMaxHeight %}<div><dt>Altitude au départ <span class="u-note">(maximum {{ settings.startMaxHeight|number_format(0, ',', ' ') }} m)</span></dt><dd{% if start.reachedAltitude > settings.startMaxHeight %} class="p-flight__alert"{% endif %}>{{ start.reachedAltitude|number_format(0, ',', ' ') }} m</dd></div>{% endif %}
                            {% endif %}
                            {% if analysis.water is defined and analysis.water is not null %}<div><dt>Eau (ballast) au décollage</dt><dd>{{ analysis.water }} L</dd></div>{% endif %}
                            <div><dt>Temps de vol{{ approx }}</dt><dd>{{ stats.duration|flight_time }}</dd></div>
                            <div><dt>Vitesse sol maximale</dt><dd>{{ stats.speedMax|number_format(0, ',', ' ') }} km/h</dd></div>
                            <div><dt>Meilleur gain d’altitude <span class="u-note">(après le largage)</span></dt><dd>{{ stats.bestGain|number_format(0, ',', ' ') }} m</dd></div>
                            <div><dt>Élévation cumulée <span class="u-note">(après le largage)</span></dt><dd>{{ stats.totalClimb|number_format(0, ',', ' ') }} m</dd></div>
                            <div><dt>Posé en cours de vol</dt><dd>{{ stats.stops > 0 ? 'Oui' ~ (stats.stops > 1 ? ' (' ~ stats.stops ~ ' fois)' : '') : 'Non' }}</dd></div>
                            <div><dt>Spirales à droite <span class="u-note">(séries d’un tour ou plus)</span></dt><dd>{{ stats.rightSpirals }}{% if stats.rightClimb is not null %} <span class="u-note">({{ stats.rightClimb|number_format(1, ',', ' ') }} m/s)</span>{% endif %}</dd></div>
                            <div><dt>Spirales à gauche</dt><dd>{{ stats.leftSpirals }}{% if stats.leftClimb is not null %} <span class="u-note">({{ stats.leftClimb|number_format(1, ',', ' ') }} m/s)</span>{% endif %}</dd></div>
                            {% if stats.bandBottom is not null %}<div><dt>Bande exploitée <span class="u-note">(entrée → sortie des thermiques du circuit, en moyenne)</span></dt><dd>{{ stats.bandBottom|number_format(0, ',', ' ') }} → {{ stats.bandTop|number_format(0, ',', ' ') }} m</dd></div>{% endif %}
                            {% if stats.glideDetour is not null %}<div><dt>Écart des transitions à la ligne droite <span class="u-note">(points toutes les 30 s, coupées aux points de virage)</span></dt><dd>+{{ (stats.glideDetour * 100)|number_format(1, ',', ' ') }} %</dd></div>{% endif %}
                        </dl>
                    </div>
                </section>
                {% if final %}
                    <section class="c-card c-card--outlined t-paper" aria-labelledby="final-title">
                        <div class="c-card__body l-stack l-stack--sm">
                            <twig:Ui:Heading level="2" size="h4" id="final-title">Transition finale</twig:Ui:Heading>
                            <dl class="p-flight__facts">
                                {% if final.climb is not null %}<div><dt>Dernière ascendance</dt><dd>{{ final.climb|number_format(1, ',', ' ') }} m/s</dd></div>{% endif %}
                                <div><dt>Distance</dt><dd>{{ final.distance|flight_distance }}</dd></div>
                                <div><dt>Durée{{ approx }}</dt><dd>{{ final.duration|flight_time }}{% if final.speed %} <span class="u-note">· {{ final.speed|number_format(0, ',', ' ') }} km/h</span>{% endif %}</dd></div>
                                <div><dt>Altitude au départ de la finale</dt><dd>{{ final.startAltitude|number_format(0, ',', ' ') }} m</dd></div>
                                <div><dt>Altitude à l’arrivée</dt><dd>{{ final.arrivalAltitude|number_format(0, ',', ' ') }} m</dd></div>
                                {% if settings and settings.finishMinHeight %}
                                    {% set excess = final.arrivalAltitude - settings.finishMinHeight %}
                                    <div><dt>Altitude minimale du circuit</dt><dd>{{ settings.finishMinHeight|number_format(0, ',', ' ') }} m</dd></div>
                                    <div><dt>{{ excess >= 0 ? 'Hauteur en trop' : 'Arrivée trop basse' }}</dt><dd{% if excess < 0 %} class="p-flight__alert"{% endif %}>{{ excess >= 0 ? '+' : '' }}{{ excess|number_format(0, ',', ' ') }} m</dd></div>
                                {% else %}
                                    <div><dt>Hauteur au-dessus du point d’arrivée</dt><dd>{{ final.height|number_format(0, ',', ' ') }} m</dd></div>
                                {% endif %}
                            </dl>
                            {% if settings and settings.finishMinHeight %}
                                {% if excess > 0 and final.climb %}
                                    <p class="u-note">Au taux de la dernière ascendance ({{ final.climb|number_format(1, ',', ' ') }} m/s), ces {{ excess|number_format(0, ',', ' ') }} m de trop représentent {{ (excess / final.climb)|flight_time }} de montée qui n’ont rien rapporté.</p>
                                {% elseif excess < 0 %}
                                    <p class="u-note">L’arrivée sous l’altitude minimale coûte {{ settings.penalties.LowFinish|default(1) }} point par mètre manquant.</p>
                                {% endif %}
                            {% elseif final.heightTime %}
                                <p class="u-note">Au taux de la dernière ascendance, ces {{ final.height|number_format(0, ',', ' ') }} m représentent {{ final.heightTime|flight_time }} de montée. L’altitude minimale d’arrivée du circuit est connue quand la session a ses réglages (lien Condor Club ou fichier .fpl).</p>
                            {% endif %}
                        </div>
                    </section>
                {% endif %}
            </div>
        {% endif %}

        {% if settings %}
            <div class="l-container">{{ include('session/_settings.html.twig') }}</div>
        {% endif %}

        {% if advice is not empty %}
            <div class="l-container p-flight__advice">
                <twig:Ui:Heading level="2" size="h4">Conseils</twig:Ui:Heading>
                <ul class="p-flight__advice-list">
                    {% for item in advice %}
                        <li class="p-flight__advice-item p-flight__advice-item--{{ item.kind }}">
                            <strong class="p-flight__advice-title">{{ item.title }}</strong>
                            <p>{{ item.text }}</p>
                            {% if item.step %}<twig:Ui:Tag variant="soft">{{ item.step.title }}</twig:Ui:Tag>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <p class="u-note">Repères calculés sur la trace, à discuter avec un formateur : ils signalent où regarder, pas une note.</p>
            </div>
        {% endif %}

        <div class="p-flight__viewer">
            {# What the symbols of the map (in 3D mostly) and of the timeline mean #}
            <details class="p-flight__key">
                <summary>
                    <twig:ux:icon name="info" class="p-flight__key-icon" />
                    <span><strong>Légende</strong> : que veulent dire les cylindres, les flèches et les repères de la frise ?</span>
                    <twig:ux:icon name="chevron-down" class="p-flight__key-chevron" />
                </summary>
                <div class="p-flight__key-columns">
                    <section>
                        <h2 class="p-flight__key-title">Sur la carte en 3D</h2>
                        <ul class="p-flight__key-list">
                            <li><span class="p-flight__swatch p-flight__swatch--column" aria-hidden="true"><i style="--swatch: var(--color-climb-1)"></i><i style="--swatch: var(--color-climb-2)"></i><i style="--swatch: var(--color-climb-3)"></i><i style="--swatch: var(--color-climb-4)"></i></span>
                                <span><strong>Vos thermiques</strong> : un cylindre fin à la position moyenne de vos spirales, de l’entrée à la sortie, plus foncé quand ça monte plus (moins de 1, 1 à 2, 2 à 3, plus de 3 m/s).</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--wide" aria-hidden="true"></span>
                                <span><strong>Thermiques des autres pilotes de la course</strong> : un gros cylindre translucide là où ils ont spiralé, de leur entrée la plus basse à leur sortie la plus haute ; les petits sont les ascendances qu’ils ont traversées sans tourner.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--missed" aria-hidden="true"></span>
                                <span><strong>Thermique manqué</strong> (jaune) : un thermique d’un autre pilote, passé à moins de 500 m de son centre, à une altitude où il marchait, sans y tourner.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--arrow p-flight__swatch--slope" aria-hidden="true"></span>
                                <span><strong>Pente ou onde</strong> : bande orange sur la trace et flèches orange montant du côté du vent, là où vous avez monté en ligne droite.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--arrow p-flight__swatch--crossing" aria-hidden="true"></span>
                                <span><strong>Ascendance traversée sans spiraler</strong> : flèche claire montant jusqu’à la trace, aussi longue que la hauteur gagnée (vol en dauphin).</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--arrow p-flight__swatch--sink" aria-hidden="true"></span>
                                <span><strong>Forte descendance</strong> : flèche bleue vers le bas, là où l’air descendait à plus de 2 m/s (netto).</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--arrow p-flight__swatch--wind" aria-hidden="true"></span>
                                <span><strong>Manche à air</strong> : flèche blanche au sommet de chaque thermique, dans le sens où va le vent, plus longue quand il est fort (vitesse affichée de près).</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--curtain" aria-hidden="true"></span>
                                <span><strong>Rideau et ombre</strong> : des traits vers le sol aux couleurs de la trace, pour lire la hauteur, et l’ombre de la trace sur le relief.</span></li>
                        </ul>
                    </section>
                    <section>
                        <h2 class="p-flight__key-title">Sous la barre de lecture</h2>
                        <ul class="p-flight__key-list">
                            <li><span class="p-flight__swatch p-flight__swatch--band" aria-hidden="true"></span>
                                <span><strong>Thermique</strong> : bande de la couleur de sa montée ; hachurée pendant le centrage et en haut quand il monte moins que votre moyenne.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--band p-flight__swatch--lift" aria-hidden="true"></span>
                                <span><strong>Pente ou onde</strong>.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--tick" aria-hidden="true"></span>
                                <span><strong>Ascendance traversée</strong> (trait en haut) et <strong>forte descendance</strong> (trait bleu en bas).</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--triangle p-flight__swatch--low" aria-hidden="true"></span>
                                <span><strong>Point bas</strong> : bien plus bas que vos entrées de thermique habituelles.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--triangle p-flight__swatch--missed-tick" aria-hidden="true"></span>
                                <span><strong>Thermique de la course manqué</strong>, au moment où vous en étiez le plus près.</span></li>
                            <li><span class="p-flight__swatch p-flight__swatch--final" aria-hidden="true"></span>
                                <span><strong>Transition finale</strong>, et au-dessus de la barre les points de virage.</span></li>
                        </ul>
                        <p class="p-flight__key-hint">Survolez un repère pour ses valeurs, cliquez pour y aller.</p>
                    </section>
                </div>
            </details>
            <div class="p-flight__map-wrap">
                <div class="p-flight__map" data-flight-viewer-target="map" role="region" aria-label="Carte du vol"></div>
                <div class="p-flight__map-tools">
                    <div class="p-flight__toggles" role="group" aria-label="Vue">
                        <button type="button" class="p-flight__toggle" aria-pressed="true" data-flight-viewer-target="view" data-view="2d" data-action="flight-viewer#setView"><twig:ux:icon name="map" /> Carte</button>
                        <button type="button" class="p-flight__toggle" aria-pressed="false" data-flight-viewer-target="view" data-view="3d" data-action="flight-viewer#setView"><twig:ux:icon name="mountain" /> 3D</button>
                    </div>
                    <label class="p-flight__select">
                        <span class="u-visually-hidden">Fond de carte</span>
                        <select data-flight-viewer-target="basemap" data-action="flight-viewer#setBasemap">
                            <option value="topo">Relief</option>
                            <option value="satellite">Satellite</option>
                            <option value="osm">Plan</option>
                        </select>
                    </label>
                    <label class="p-flight__select">
                        <span class="u-visually-hidden">Couleur de la trace</span>
                        <select data-flight-viewer-target="colors" data-action="flight-viewer#setColors">
                            <option value="vario">Trace : vario</option>
                            <option value="altitude">Trace : altitude</option>
                            {% if performance %}<option value="netto">Trace : netto</option>{% endif %}
                        </select>
                    </label>
                    <label class="p-flight__select" data-flight-viewer-target="airChoice" hidden>
                        <span class="u-visually-hidden">Thermiques des autres pilotes de la course</span>
                        <select data-flight-viewer-target="air" data-action="flight-viewer#render">
                            <option value="all">Course : thermiques des autres</option>
                            <option value="missed">Course : thermiques manqués</option>
                            <option value="none">Course : masquée</option>
                        </select>
                    </label>
                    <button type="button" class="p-flight__toggle p-flight__follow" aria-pressed="false" data-flight-viewer-target="follow" data-action="flight-viewer#toggleFollow"><twig:ux:icon name="crosshair" /> Suivre</button>
                    <button type="button" class="p-flight__toggle p-flight__follow" aria-pressed="false" data-flight-viewer-target="pilot" data-action="flight-viewer#togglePilot" title="En 3D, la caméra dans le planeur, inclinée avec lui"><twig:ux:icon name="glider" /> Vue pilote</button>
                </div>
                <div class="p-flight__legend" data-flight-viewer-target="legend" aria-hidden="true">
                    <span data-legend="low"></span><span class="p-flight__legend-bar" data-legend="bar"></span><span data-legend="high"></span>
                </div>
                <p class="p-flight__loading" data-flight-viewer-target="status" role="status">Chargement du vol…</p>
            </div>

            <aside class="p-flight__side" aria-label="Valeurs au point courant">
                <dl class="p-flight__now">
                    <div><dt>Temps{{ approx }}</dt><dd data-flight-viewer-target="nowTime">—</dd></div>
                    <div><dt>Altitude</dt><dd data-flight-viewer-target="nowAltitude">—</dd></div>
                    <div><dt>Vitesse sol</dt><dd data-flight-viewer-target="nowSpeed">—</dd></div>
                    <div><dt>Vario (4 s)</dt><dd data-flight-viewer-target="nowVario">—</dd></div>
                </dl>
                <p class="p-flight__phase" data-flight-viewer-target="nowPhase"></p>

                {% if task %}
                    <section class="l-stack l-stack--sm">
                        <h2 class="p-flight__side-title">Circuit · {{ task.distance|flight_distance }}</h2>
                        <ol class="p-flight__legs">
                            {% for leg in task.legs %}
                                <li>
                                    <span class="p-flight__leg-name">{{ leg.from }} → {{ leg.to }}</span>
                                    <span class="p-flight__leg-values">{{ leg.distance|flight_distance }} · {{ leg.duration is not null ? leg.duration|flight_duration ~ ' · ' ~ leg.speed|number_format(0, ',', ' ') ~ ' km/h' : 'non atteint' }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                    </section>
                {% endif %}

                <section class="l-stack l-stack--sm p-flight__radar" data-flight-viewer-target="radar" hidden>
                    <h2 class="p-flight__side-title" data-flight-viewer-target="radarTitle">Centrage</h2>
                    <canvas class="p-flight__radar-canvas" width="200" height="200" data-flight-viewer-target="radarCanvas"
                            data-action="mousemove->flight-viewer#pointRadar mouseleave->flight-viewer#leaveRadar"
                            role="img" aria-label="Vario moyen de chaque côté des cercles"></canvas>
                    <p class="p-flight__radar-value" data-flight-viewer-target="radarValue"></p>
                    <p class="p-flight__radar-advice" data-flight-viewer-target="radarAdvice"></p>
                    <p class="p-flight__radar-advice" data-flight-viewer-target="radarTiming"></p>
                </section>

                <section class="l-stack l-stack--sm">
                    <h2 class="p-flight__side-title">Thermiques et transitions</h2>
                    <ol class="p-flight__phases" data-flight-viewer-target="phases"></ol>
                </section>
            </aside>

            <div class="p-flight__replay">
                <button type="button" class="p-flight__play" data-flight-viewer-target="play" data-action="flight-viewer#togglePlay" aria-label="Rejouer le vol">
                    <twig:ux:icon name="play" class="p-flight__play-icon--play" /><twig:ux:icon name="pause" class="p-flight__play-icon--pause" />
                </button>
                <label class="p-flight__select">
                    <span class="u-visually-hidden">Vitesse de lecture</span>
                    <select data-flight-viewer-target="rate">
                        <option value="1">× 1</option>
                        <option value="2">× 2</option>
                        <option value="3">× 3</option>
                        <option value="10">× 10</option>
                        <option value="30" selected>× 30</option>
                        <option value="60">× 60</option>
                        <option value="120">× 120</option>
                        <option value="300">× 300</option>
                    </select>
                </label>
                <div class="p-flight__timeline">
                    <input type="range" class="p-flight__seek" min="0" max="0" value="0" step="1" aria-label="Position dans le vol"
                           data-flight-viewer-target="seek" data-action="input->flight-viewer#seek">
                    <div class="p-flight__marks" data-flight-viewer-target="marks"></div>
                    {# Thermals, slope lift, low points and final glide; the list of phases gives them to the keyboard #}
                    <div class="p-flight__events" data-flight-viewer-target="events" aria-hidden="true"></div>
                </div>
                <button type="button" class="p-flight__moment" data-action="flight-viewer#copyMoment" title="Copier l’adresse de ce vol à l’instant affiché">
                    <twig:ux:icon name="link" /><span class="u-visually-hidden">Lien vers cet instant</span>
                </button>
                <span class="p-flight__moment-status" data-flight-viewer-target="momentStatus" role="status"></span>
            </div>

            <div class="p-flight__charts">
                <figure class="p-flight__chart"><figcaption>Altitude (m) — en vert les thermiques</figcaption><div data-flight-viewer-target="chart" data-series="altitude"></div></figure>
                <figure class="p-flight__chart"><figcaption>Vario sur 4 s (m/s){% if performance %} — en pointillés le netto des transitions (l’air, polaire retirée){% endif %}</figcaption><div data-flight-viewer-target="chart" data-series="vario"></div></figure>
                <figure class="p-flight__chart"><figcaption>Vitesse sol (km/h)</figcaption><div data-flight-viewer-target="chart" data-series="speed"></div></figure>
            </div>
        </div>

        {# Phase analysis and coaching (Condor Club parity, roadmap 7g2) #}
        {% if stats.phaseThermals is defined %}
            {% set altitude = analysis.series.altitude %}
            {% set circling = stats.phaseCircling ?? stats.circlingShare %}
            <section class="l-container p-flight__phases-analysis" aria-labelledby="phases-title">
                <twig:Ui:Heading level="2" size="h3" id="phases-title">Analyse par phases</twig:Ui:Heading>
                <div class="p-flight__stats">
                    <twig:Ui:Stat label="Thermiques" value="{{ stats.phaseThermals }} · {{ circling is not null ? (circling * 100)|number_format(1, ',', ' ') ~ ' %' : '—' }}" unit="du temps en spirale" />
                    <twig:Ui:Stat label="Montée moyenne" value="{{ stats.phaseClimb is not null ? '+' ~ stats.phaseClimb|number_format(2, ',', ' ') : '—' }}" unit="m/s en thermique" />
                    <twig:Ui:Stat label="Gauche / droite" value="{{ stats.phaseLeftShare is not null ? (stats.phaseLeftShare * 100)|round ~ ' / ' ~ ((1 - stats.phaseLeftShare) * 100)|round : '—' }}" unit="% du temps en spirale" />
                    <twig:Ui:Stat label="Bande exploitée" value="{{ stats.bandBottom is not null ? stats.bandBottom|number_format(0, ',', ' ') ~ ' → ' ~ stats.bandTop|number_format(0, ',', ' ') : '—' }}" unit="m, entrée → sortie" />
                    <twig:Ui:Stat label="Transitions" value="{{ (stats.phaseGlideDistance / 1000)|number_format(0, ',', ' ') }} km · {{ stats.phaseGlideSpeed is not null ? stats.phaseGlideSpeed|number_format(0, ',', ' ') : '—' }}" unit="km/h{{ stats.glideDetour is not null ? ', détour +' ~ (stats.glideDetour * 100)|number_format(1, ',', ' ') ~ ' %' : '' }}" />
                    <twig:Ui:Stat label="Finesse réalisée" value="{{ stats.phaseGlideRatio is not null ? stats.phaseGlideRatio|number_format(1, ',', ' ') : '—' }}" unit="en transition" />
                    <twig:Ui:Stat label="Vent (dérive en spirale)" value="{{ stats.windSpeed is not null ? stats.windSpeed|number_format(0, ',', ' ') ~ ' km/h' : '—' }}" unit="{{ stats.windFrom is not null ? 'du ' ~ stats.windFrom ~ '°' : '' }}" />
                    <twig:Ui:Stat label="Pente ou onde" value="{{ stats.lifts }}" unit="{{ stats.lifts > 0 ? 'montée' ~ (stats.lifts > 1 ? 's' : '') ~ ' en ligne droite, +' ~ stats.liftGain|number_format(0, ',', ' ') ~ ' m' : 'montée en ligne droite' }}" />
                </div>
                {% if race and (race.climb or race.glide) %}
                    <p class="p-flight__race-rank">Parmi les {{ race.count }} traces de cette course :{% if race.climb %} montée n<sup>o</sup> {{ race.climb }}{% endif %}{% if race.climb and race.glide %} ·{% endif %}{% if race.glide %} transition n<sup>o</sup> {{ race.glide }}{% endif %} <span class="u-note">(vario moyen en thermique, vitesse des transitions)</span></p>
                {% endif %}
                <p class="u-note">Sur le circuit quand il est terminé, sur tout le vol sinon.</p>

                <figure class="c-data-table">
                    <div class="c-data-table__scroll" tabindex="0" role="region" aria-label="Phases du vol">
                        <table>
                            <thead><tr><th scope="col">Phase</th><th scope="col">Début{{ approx }}</th><th scope="col">Durée</th><th scope="col">Altitude</th><th scope="col">Vario</th><th scope="col">Détails</th></tr></thead>
                            <tbody>
                                {% for phase in analysis.phases %}
                                    <tr class="p-flight__phase-row p-flight__phase-row--{{ phase.type }}">
                                        <th scope="row">{{ {thermal: 'Thermique', glide: 'Transition', lift: 'Pente ou onde', launch: 'Lancement'}[phase.type] }}{% if phase.direction %} {{ phase.direction == 'left' ? 'G' : 'D' }}{% endif %}</th>
                                        <td><button type="button" class="p-flight__comment-at" data-action="flight-viewer#goTo" data-flight-viewer-at-param="{{ phase.start }}">{{ phase.start|flight_clock }}</button></td>
                                        <td>{{ phase.duration|flight_clock }}</td>
                                        <td>{{ altitude[phase.start]|number_format(0, ',', ' ') }} → {{ altitude[phase.end]|number_format(0, ',', ' ') }} m</td>
                                        <td class="{{ phase.vario >= 0 ? 'p-flight__up' : 'p-flight__down' }}">{{ phase.vario >= 0 ? '+' : '' }}{{ phase.vario|number_format(1, ',', ' ') }} m/s</td>
                                        <td class="u-note">
                                            {%- if phase.type == 'thermal' -%}
                                                {{ [phase.turns ? phase.turns|number_format(1, ',', ' ') ~ ' tours' : null, phase.radius ? 'r ' ~ phase.radius ~ ' m' : null, phase.bank ? phase.bank ~ '°' : null, phase.windSpeed is not null and phase.windFrom is not null ? 'vent ' ~ phase.windSpeed|number_format(0) ~ ' km/h du ' ~ phase.windFrom ~ '°' : null, phase.entry is defined and phase.entry is not null ? (phase.entry == 0 ? 'centré dès le 1er tour' : 'centré en ' ~ phase.entry ~ ' s') : null, phase.exit is defined and phase.exit ? phase.exit ~ ' s en haut sous la moyenne' : null]|filter(v => v)|join(' · ') }}
                                            {%- else -%}
                                                {{ [phase.distance|flight_distance, phase.speed|number_format(0, ',', ' ') ~ ' km/h', phase.glideRatio ? 'finesse ' ~ phase.glideRatio|number_format(0, ',', ' ') : null]|filter(v => v)|join(' · ') }}
                                            {%- endif -%}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </figure>

                <div class="p-flight__coach">
                    {% if stats.spiralRadius %}
                        {% set target = stats.spiralTarget %}
                        {% set verdict = target is null ? null : (stats.spiralRadius > target * 1.15 ? 'Large' : (stats.spiralRadius < target * 0.85 ? 'Serrée' : 'Bonne')) %}
                        <section class="c-card c-card--outlined t-paper" aria-labelledby="spiral-title">
                            <div class="c-card__body l-stack l-stack--sm">
                                <twig:Ui:Heading level="3" size="h4" id="spiral-title">Spirale{% if verdict %} · {{ verdict }}{% endif %}</twig:Ui:Heading>
                                <dl class="p-flight__facts">
                                    <div><dt>Rayon moyen</dt><dd>{{ stats.spiralRadius }} m</dd></div>
                                    {% if target %}<div><dt>Rayon de vos meilleures montées</dt><dd>{{ target }} m</dd></div>{% endif %}
                                    <div><dt>Inclinaison moyenne <span class="u-note">(estimée)</span></dt><dd>{{ stats.spiralBank }}°</dd></div>
                                </dl>
                                <p class="u-note">La cible est le rayon de vos meilleures montées du vol (le meilleur quart). Spiraler plus large que la cible veut souvent dire que le cœur n’était pas centré ; beaucoup plus serré augmente la chute du planeur.</p>
                            </div>
                        </section>
                    {% endif %}
                    {% if analysis.climbByAltitude is not empty %}
                        {% set best = max(analysis.climbByAltitude|map(b => b.climb)) %}
                        <section class="c-card c-card--outlined t-paper" aria-labelledby="climb-title">
                            <div class="c-card__body l-stack l-stack--sm">
                                <twig:Ui:Heading level="3" size="h4" id="climb-title">Taux de montée par altitude</twig:Ui:Heading>
                                <ol class="p-flight__bars">
                                    {% for band in analysis.climbByAltitude|reverse %}
                                        <li title="{{ band.seconds|flight_time }} en thermique dans cette tranche">
                                            <span class="p-flight__bar-label">{{ band.bottom|number_format(0, ',', ' ') }} m</span>
                                            <span class="p-flight__bar"><span style="width: {{ best > 0 ? (max(band.climb, 0) / best * 100)|round : 0 }}%"></span></span>
                                            <span class="p-flight__bar-value">{{ band.climb >= 0 ? '+' : '' }}{{ band.climb|number_format(1, ',', ' ') }} m/s</span>
                                        </li>
                                    {% endfor %}
                                </ol>
                                <p class="u-note">Vario moyen en thermique par tranche de 200 m : où les thermiques portaient le mieux.</p>
                            </div>
                        </section>
                    {% endif %}
                    {% set winds = analysis.phases|filter(p => p.type == 'thermal' and p.windSpeed is not null and p.windFrom is not null) %}
                    {% if winds is not empty %}
                        <section class="c-card c-card--outlined t-paper" aria-labelledby="wind-title">
                            <div class="c-card__body l-stack l-stack--sm">
                                <twig:Ui:Heading level="3" size="h4" id="wind-title">Vent par altitude</twig:Ui:Heading>
                                <ol class="p-flight__winds">
                                    {% for phase in winds|sort((a, b) => altitude[b.end] <=> altitude[a.end]) %}
                                        <li>
                                            <span class="p-flight__bar-label">{{ ((altitude[phase.start] + altitude[phase.end]) / 2)|number_format(0, ',', ' ') }} m</span>
                                            <span class="p-flight__wind-arrow" style="transform: rotate({{ phase.windFrom + 180 }}deg)" aria-hidden="true">↑</span>
                                            <span class="p-flight__bar-value">{{ phase.windSpeed|number_format(0) }} km/h du {{ phase.windFrom }}°</span>
                                        </li>
                                    {% endfor %}
                                </ol>
                                <p class="u-note">Mesuré par la dérive de chaque thermique, à son altitude moyenne.</p>
                            </div>
                        </section>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {% if performance %}
            {% set glider = performance.glider %}
            <section class="l-container p-flight__glider" aria-labelledby="glider-title">
                <twig:Ui:Heading level="2" size="h3" id="glider-title">Le planeur et sa polaire</twig:Ui:Heading>
                <div class="p-flight__glider-grid">
                    <dl class="p-flight__facts">
                        <div><dt>Planeur</dt><dd><a href="{{ path('app_glider_show', {name: glider.name}) }}">{{ glider.model }}</a></dd></div>
                        <div><dt>Masse en vol <span class="u-note">({{ performance.water is not null ? performance.water ~ ' L d’eau' : 'eau inconnue' }})</span></dt><dd>{{ performance.mass|number_format(0, ',', ' ') }} kg</dd></div>
                        <div><dt>Charge alaire</dt><dd>{{ performance.wingLoading|number_format(1, ',', ' ') }} kg/m² <span class="u-note">({{ glider.minWingLoading|number_format(1, ',', ' ') }} à {{ glider.maxWingLoading|number_format(1, ',', ' ') }})</span></dd></div>
                        <div><dt>Finesse maximale à cette masse</dt><dd>{{ performance.bestGlide.ratio|number_format(0, ',', ' ') }} à {{ performance.bestGlide.speed|number_format(0, ',', ' ') }} km/h</dd></div>
                        <div><dt>Taux de chute minimal</dt><dd>{{ performance.minimumSink.sink|number_format(2, ',', ' ') }} m/s à {{ performance.minimumSink.speed|number_format(0, ',', ' ') }} km/h</dd></div>
                        {% if performance.speedToFly %}
                            <div><dt>Vitesse MacCready <span class="u-note">(pour le vario moyen du vol, {{ performance.climb|number_format(1, ',', ' ') }} m/s)</span></dt><dd>{{ performance.speedToFly.speed|number_format(0, ',', ' ') }} km/h</dd></div>
                            <div><dt>Vitesse moyenne espérée <span class="u-note">(montée et transitions, air calme)</span></dt><dd>{{ performance.speedToFly.average|number_format(0, ',', ' ') }} km/h</dd></div>
                        {% endif %}
                        {% if performance.glideSpeed %}<div><dt>Vos transitions <span class="u-note">(vitesse air estimée{{ performance.wind ? ', vent de ' ~ performance.wind.speed|number_format(0) ~ ' km/h retiré' : '' }})</span></dt><dd>{{ performance.glideSpeed|number_format(0, ',', ' ') }} km/h</dd></div>{% endif %}
                        {% if performance.glideMacCready is not null %}<div><dt>MacCready effectif <span class="u-note">(le réglage dont vos transitions sont la vitesse)</span></dt><dd>{{ performance.glideMacCready|number_format(1, ',', ' ') }} m/s</dd></div>{% endif %}
                        {% if performance.glideNetto is not null %}<div><dt>Netto moyen en transition <span class="u-note">(mouvement de l’air traversé)</span></dt><dd>{{ performance.glideNetto > 0 ? '+' : '' }}{{ performance.glideNetto|number_format(1, ',', ' ') }} m/s</dd></div>{% endif %}
                    </dl>
                    <figure class="p-flight__chart p-flight__polar" data-controller="polar-chart"
                            data-polar-chart-curves-value="{{ [{label: 'Polaire à ' ~ performance.wingLoading|number_format(1, ',', ' ') ~ ' kg/m²', points: performance.chartData.curve}]|json_encode }}"
                            data-polar-chart-glides-value="{{ performance.chartData.glides|json_encode }}"
                            data-polar-chart-speed-to-fly-value="{{ performance.chartData.speedToFly ?? 0 }}"
                            data-action="polar-chart:glide->flight-viewer#goToMoment">
                        <figcaption>Polaire à la masse du vol (taux de chute selon la vitesse air), vos transitions en points{% if performance.speedToFly %}, la vitesse MacCready en pointillés{% endif %}</figcaption>
                        <div data-polar-chart-target="chart"></div>
                    </figure>
                </div>
                <p class="u-note">La trace donne la vitesse sol : la vitesse air d’une transition est estimée en retirant le vent mesuré par la dérive des thermiques. Une transition au-dessus de la courbe a traversé de l’air montant, en dessous de l’air descendant : l’écart est son netto, aussi tracé seconde par seconde sous le vario. Polaire et fiche du planeur lues dans les fichiers de Condor.</p>
            </section>
        {% endif %}

        {% if task and task.turnpoints[0].reachedAltitude is defined %}
            {% set points = task.turnpoints %}
            {% set start = points[1].reached %}
            <section class="l-container p-flight__turnpoints" aria-labelledby="turnpoints-title">
                <twig:Ui:Heading level="2" size="h3" id="turnpoints-title">Points de virage</twig:Ui:Heading>
                <figure class="c-data-table">
                    <div class="c-data-table__scroll" tabindex="0" role="region" aria-label="Passage des points de virage">
                        <table>
                            <thead><tr><th scope="col">Point</th><th scope="col">Nom</th><th scope="col">Altitude du point</th><th scope="col">Atteint à{{ approx }}</th><th scope="col">Altitude au passage</th><th scope="col">Branche</th><th scope="col">Depuis le départ</th><th scope="col">Vitesse sol au passage</th></tr></thead>
                            <tbody>
                                <tr>
                                    <th scope="row">Décollage</th>
                                    <td>{{ points[0].name }}</td>
                                    <td>{{ points[0].altitude|number_format(0, ',', ' ') }} m</td>
                                    <td>{{ stats.takeoff|flight_clock }}</td>
                                    <td>—</td><td>—</td><td>—</td><td>—</td>
                                </tr>
                                {% for point in points|slice(1) %}
                                    {% set k = loop.index %}
                                    {% set previous = points[k - 1].reached %}
                                    <tr>
                                        <th scope="row">{{ k == 1 ? 'Départ' : (loop.last ? 'Arrivée' : 'TP ' ~ (k - 1)) }}</th>
                                        <td>{{ point.name }}</td>
                                        <td>{{ point.altitude|number_format(0, ',', ' ') }} m</td>
                                        {% if point.reached is not null %}
                                            <td><button type="button" class="p-flight__comment-at" data-action="flight-viewer#goTo" data-flight-viewer-at-param="{{ point.reached }}">{{ point.reached|flight_clock }}</button></td>
                                            <td>{{ point.reachedAltitude|number_format(0, ',', ' ') }} m</td>
                                            <td>{{ k > 1 and previous is not null ? '+' ~ (point.reached - previous)|flight_clock : '—' }}</td>
                                            <td>{{ k > 1 and start is not null ? '+' ~ (point.reached - start)|flight_clock : '—' }}</td>
                                            <td>{{ point.reachedSpeed|number_format(0, ',', ' ') }} km/h</td>
                                        {% else %}
                                            <td colspan="5">non atteint</td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </figure>
            </section>
        {% endif %}

        <section class="l-container p-flight__thermals" data-flight-viewer-target="thermals" hidden aria-labelledby="thermals-title">
            <twig:Ui:Heading level="2" size="h3" id="thermals-title">Deux thermiques côte à côte</twig:Ui:Heading>
            <p class="u-note" data-flight-viewer-target="thermalHint">Choisissez un deuxième thermique dans la liste (« Comparer »).</p>
            <div class="c-data-table p-flight__thermal-table" data-flight-viewer-target="thermalTable"></div>
            <figure class="p-flight__chart"><figcaption>Gain depuis l’entrée dans chaque thermique (m)</figcaption><div data-flight-viewer-target="thermalChart"></div></figure>
        </section>

        {% if app.user %}
        <div class="l-container p-flight__comments" id="commentaires">
            <twig:Ui:Heading level="2" size="h3">Commentaires</twig:Ui:Heading>
            {% if flight.comments is empty %}
                <p class="u-note">Aucun commentaire pour l’instant.{% if comment_form %} Le pilote et les formateurs peuvent commenter le vol, ou un instant précis : placez le planeur au bon endroit avec la carte, les courbes ou la barre de lecture.{% endif %}</p>
            {% else %}
                <ol class="p-flight__comment-list">
                    {% for comment in flight.comments %}
                        <li class="p-flight__comment">
                            <div class="p-flight__comment-head">
                                <strong>{{ comment.author ? comment.author.displayName : 'Compte supprimé' }}</strong>
                                <span class="u-note">{{ comment.createdAt|format_datetime('medium', 'short', locale: 'fr') }}</span>
                                {% if comment.at is not null %}
                                    <button type="button" class="p-flight__comment-at" data-action="flight-viewer#goTo" data-flight-viewer-at-param="{{ comment.at }}">
                                        <twig:ux:icon name="crosshair" /> {{ comment.at|flight_clock }}
                                    </button>
                                {% endif %}
                                {% if comment.step %}<twig:Ui:Tag variant="soft">{{ comment.step.title }}</twig:Ui:Tag>{% endif %}
                            </div>
                            <p class="p-flight__comment-body">{{ comment.body|nl2br }}</p>
                            {% if is_granted('FLIGHT_COMMENT_DELETE', comment) %}
                                <form method="post" action="{{ path('app_flight_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                    <button type="submit" class="p-flight__comment-delete">Supprimer</button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}

            {% if comment_form %}
                {{ form_start(comment_form, {attr: {class: 'c-card c-card--outlined t-paper p-flight__comment-form'}}) }}
                    <div class="c-card__body c-form">
                        {{ form_row(comment_form.body) }}
                        {{ form_row(comment_form.step) }}
                        <div class="p-flight__comment-moment">
                            {{ form_row(comment_form.atMoment) }}
                            <span class="p-flight__comment-time" data-flight-viewer-target="commentTime" title="Instant affiché par la carte et les courbes">—</span>
                        </div>
                        {{ form_widget(comment_form.at) }}
                        <div><twig:Ui:Button type="submit">Commenter</twig:Ui:Button></div>
                    </div>
                {{ form_end(comment_form) }}
            {% endif %}
        </div>
        {% endif %}
    </section>
{% endblock %}
