{% extends 'base.html.twig' %}

{% set flights = session.flights %}
{% set exact = flights|filter(f => not f.analysis.exactTimes) is empty %}
{% set approx = exact ? '' : ' (estimée)' %}

{% block title %}Session {{ session.flightPlan ?? flight.pilot }}{% endblock %}
{% block description %}Classement et replay des vols de la session {{ session.flightPlan }}.{% endblock %}

{% block body %}
    <section class="p-flight t-light" data-controller="session-viewer"
             data-session-viewer-url-value="{{ path('app_flight_session_data', {id: flight.id}) }}">
        <div class="l-container p-flight__head">
            <div class="l-stack l-stack--sm">
                <twig:Ui:Link href="{{ path('app_flight_index') }}">Tous les vols</twig:Ui:Link>
                <twig:Ui:Eyebrow>Session · {{ flight.landscape ?? flight.simulator }}</twig:Ui:Eyebrow>
                <twig:Ui:Heading level="1" size="h2">{{ session.flightPlan ?? 'Vol sans plan de vol' }}</twig:Ui:Heading>
                <p class="p-flight__meta">{{ flights|length }} {{ flights|length > 1 ? 'vols' : 'vol' }} sur ce plan de vol</p>
                {% if not exact %}
                    <p class="u-note">Les heures de certaines traces n’ont pas pu être lues : leurs temps et leurs vitesses sont estimés (à quelques pourcents près).</p>
                {% endif %}
            </div>
        </div>

        {{ include('flight/_session_replay.html.twig', {current: flight.id}) }}
        {% if flights|length == 1 %}
            <div class="l-container"><p class="u-note">Seul ce vol est enregistré sur ce plan de vol pour l’instant.</p></div>
        {% endif %}
    </section>
{% endblock %}
