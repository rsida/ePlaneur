{#
    The training path of a pilot in their logbook (App\Training\TrainingPath): the eight steps, where
    the pilot stands on each, and for a trainer the form of each step. Variables: path,
    training_forms (step number → form view, empty when read only), own.
#}
<section class="l-stack l-stack--sm p-training" id="parcours" aria-labelledby="training-title">
    <div class="p-training__head">
        <twig:Ui:Heading level="2" size="h4" id="training-title">Parcours de formation</twig:Ui:Heading>
        <p class="u-note">
            {{ path.validated }} étape{{ path.validated > 1 ? 's' : '' }} validée{{ path.validated > 1 ? 's' : '' }} sur 8
            {%- if path.qualification %} · qualification du club : <strong>{{ path.qualification }}</strong>{% endif %}
            {%- if path.current %} · {{ own ? 'votre' : 'son' }} étape en cours : {{ path.current.title }}{% endif %}
        </p>
    </div>
    {% set pilot_steps = pilot is defined ? pilot_path(pilot) : [] %}
    <ol class="p-training__steps">
        {% for item in path.steps %}
            {% set progress = item.progress %}
            {% set state = progress ? progress.status.value : 'todo' %}
            <li class="p-training__step p-training__step--{{ state }}">
                <div class="p-training__step-head">
                    <span class="p-training__number" aria-hidden="true">{{ item.step.value }}</span>
                    <strong>{{ item.step.label }}</strong>
                    {% if progress %}<twig:Ui:Tag variant="{{ state == 'validated' ? 'soft' : 'default' }}">{{ progress.status.label }}</twig:Ui:Tag>{% else %}<span class="u-note">Pas commencée</span>{% endif %}
                </div>
                {% if progress %}
                    <p class="u-note">
                        {%- if progress.validated and progress.validatedOn %}Validée le {{ progress.validatedOn|format_date('long', locale: 'fr') }}{% if item.step.qualification %} · {{ item.step.qualification }}{% endif %}{% endif -%}
                        {%- if progress.updatedBy %}{{ progress.validated and progress.validatedOn ? ' · ' : '' }}par {{ progress.updatedBy.publicName }}{% endif -%}
                    </p>
                    {% if progress.note %}<p class="p-training__note">{{ progress.note|nl2br }}</p>{% endif %}
                    {% if progress.flight %}<twig:Ui:Link href="{{ path('app_flight_show', {id: progress.flight.id}) }}">Vol de référence du {{ progress.flight.date|format_date('medium', locale: 'fr') }}</twig:Ui:Link>{% endif %}
                {% endif %}
                {% set mine = pilot_steps[item.step.value] ?? null %}
                {% if mine and mine.items is not empty and mine.state.value != 'closed' %}
                    <p class="u-note">Mon parcours : {{ mine.doneCount }} élément{{ mine.doneCount > 1 ? 's' : '' }} fait{{ mine.doneCount > 1 ? 's' : '' }} sur {{ mine.items|length }}
                        {%- for view in mine.items|filter(v => v.best) %}{{ loop.first ? ' · exercices réussis : ' : ', ' }}<a href="{{ path('app_flight_show', {id: view.best.flight.id}) }}">{{ view.item.title }}</a>{% endfor %}
                    </p>
                {% endif %}
                {% if training_forms[item.step.value] is defined %}
                    <details class="p-training__edit">
                        <summary>Mettre à jour l’étape</summary>
                        {{ form_start(training_forms[item.step.value], {attr: {class: 'l-stack l-stack--sm'}}) }}
                            {{ form_widget(training_forms[item.step.value]) }}
                            <div><twig:Ui:Button type="submit" size="sm" icon="">Enregistrer</twig:Ui:Button></div>
                        {{ form_end(training_forms[item.step.value]) }}
                    </details>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
    {% if own %}<twig:Ui:Link href="{{ path('app_path') }}">Mon parcours : lectures, exercices et quiz de chaque étape</twig:Ui:Link>{% endif %}
    {% if training_forms is empty %}
        <p class="u-note">Les formateurs du club marquent les étapes en cours et validées, avec une note et un vol de référence.</p>
    {% endif %}
</section>
