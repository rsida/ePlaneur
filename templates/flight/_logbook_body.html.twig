{# Content of a logbook (Logbook::of()): training path, totals, badges, recurring advice, trend charts, flights. #}
{% if path is defined %}{{ include('flight/_training_path.html.twig') }}{% endif %}
{% if flights is empty %}
    <p class="u-note">Aucun vol pour l’instant. <a href="{{ path('app_flight_index') }}">Ajoutez une trace</a> pour commencer le carnet.</p>
{% else %}
    <div class="p-flight__stats">
        <twig:Ui:Stat label="Vols" value="{{ flights|length }}" unit="{{ tasks }} {{ tasks > 1 ? 'circuits terminés' : 'circuit terminé' }}" />
        <twig:Ui:Stat label="Heures de vol" value="{{ hours|flight_duration }}" />
        <twig:Ui:Stat label="Distance parcourue" value="{{ distance|flight_distance }}" />
    </div>

    <section class="l-stack l-stack--sm">
        <twig:Ui:Heading level="2" size="h4">Badges</twig:Ui:Heading>
        <ul class="p-flight-logbook__badges">
            {% for item in badges %}
                <li class="p-flight-logbook__badge{{ item.flight ? ' is-earned' : '' }}" title="{{ item.badge.description }}">
                    <twig:ux:icon name="{{ item.flight ? 'trophy' : 'lock-keyhole' }}" />
                    <span class="p-flight-logbook__badge-text">
                        <strong>{{ item.badge.label }}</strong>
                        {% if item.flight %}
                            <a href="{{ path('app_flight_show', {id: item.flight.id}) }}">{{ item.flight.date|format_date('medium', locale: 'fr') }}</a>
                        {% else %}
                            <span class="u-note">{{ item.badge.description }}</span>
                        {% endif %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    </section>

    {% if skills is defined and skills is not empty %}
        <section class="l-stack l-stack--sm">
            <twig:Ui:Heading level="2" size="h4">Bilan par compétence</twig:Ui:Heading>
            <p class="u-note">Moyenne des 3 derniers vols qui la mesurent, contre les 3 d’avant.</p>
            <div class="c-data-table p-flight-logbook__skills">
                <table>
                    <thead><tr><th scope="col">Compétence</th><th scope="col">3 derniers vols</th><th scope="col">3 vols d’avant</th><th scope="col">Tendance</th></tr></thead>
                    <tbody>
                        {% for skill in skills %}
                            <tr>
                                <th scope="row">{{ skill.title }} <twig:Ui:Tag variant="soft">{{ skill.step.title }}</twig:Ui:Tag></th>
                                <td>{{ skill.recent is not null ? skill.recent|number_format(skill.decimals, ',', ' ') : '—' }} {{ skill.unit }}</td>
                                <td>{{ skill.before is not null ? skill.before|number_format(skill.decimals, ',', ' ') ~ ' ' ~ skill.unit : '—' }}</td>
                                <td class="p-flight-logbook__trend p-flight-logbook__trend--{{ skill.trend ?? 'none' }}">{{ {better: '↗ en progrès', worse: '↘ en recul', steady: '→ stable'}[skill.trend] ?? 'pas encore assez de vols' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    {% if tips is not empty %}
        <section class="l-stack l-stack--sm">
            <twig:Ui:Heading level="2" size="h4">Ce qui revient le plus</twig:Ui:Heading>
            <ul class="p-flight-logbook__tips">
                {% for tip in tips|slice(0, 4) %}
                    <li><strong>{{ tip.title }}</strong> · {{ tip.count }} {{ tip.count > 1 ? 'vols' : 'vol' }} sur {{ flights|length }}{% if tip.step %} <twig:Ui:Tag variant="soft">{{ tip.step.title }}</twig:Ui:Tag>{% endif %}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <div class="p-flight-logbook__charts" data-controller="logbook-chart" data-logbook-chart-points-value="{{ points|json_encode }}">
        <figure class="p-flight__chart"><figcaption>Vitesse circuit (km/h)</figcaption><div data-logbook-chart-target="chart" data-series="taskSpeed"></div></figure>
        <figure class="p-flight__chart"><figcaption>Vario moyen en thermique (m/s)</figcaption><div data-logbook-chart-target="chart" data-series="climb"></div></figure>
        <figure class="p-flight__chart"><figcaption>Finesse en transition</figcaption><div data-logbook-chart-target="chart" data-series="glideRatio"></div></figure>
        <figure class="p-flight__chart"><figcaption>Temps en spirale (% du vol)</figcaption><div data-logbook-chart-target="chart" data-series="circling"></div></figure>
    </div>

    <section class="l-stack l-stack--sm">
        <twig:Ui:Heading level="2" size="h3">Vols</twig:Ui:Heading>
        {{ include('flight/_list.html.twig', {flights: flights|reverse, caption: 'Vols du carnet'}) }}
    </section>
{% endif %}
