{# A flight replayed in 3D in a loop, loaded when in view (home page, presentation of the site). Takes `flight`. #}
{% set pilot = flight.competitionId ?: flight.pilot %}
<figure class="p-home-replay t-paper u-full" data-controller="home-replay"
        data-home-replay-url-value="{{ path('app_flight_replay', {id: flight.id}) }}"
        data-home-replay-label-value="{{ pilot }}">
    <div class="p-home-replay__map" data-home-replay-target="map" role="img" aria-label="Le vol de {{ pilot }} rejoué en 3D au-dessus du relief">
        <p class="p-home-replay__status" data-home-replay-target="status">Chargement du vol…</p>
    </div>
    <figcaption class="p-home-replay__caption">
        <span class="l-stack l-stack--xs">
            <strong>En l’air avec {{ flight.owner ? flight.owner.publicName : flight.pilot }}</strong>
            <span class="u-note">{{ flight.flightPlan ?? flight.glider }} · {{ flight.distance|flight_distance }} · {{ flight.duration|flight_duration }}{% if flight.taskSpeed %} · {{ flight.taskSpeed|number_format(1, ',', ' ') }} km/h{% endif %} · rejoué 60 fois plus vite</span>
        </span>
        <span class="l-cluster">
            <button type="button" class="c-button c-button--outline c-button--sm" data-home-replay-target="toggle" data-action="home-replay#toggle">Pause</button>
            <twig:Ui:Link href="{{ path('app_flight_show', {id: flight.id}) }}">Voir le vol en détail</twig:Ui:Link>
        </span>
    </figcaption>
</figure>
