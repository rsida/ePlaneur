{% extends 'base.html.twig' %}

{#
    Article page (Figma "Article desktop", node 29-4356): editorial header, cover, table of contents
    with the sidebar blocks, body blocks, closing blocks, author and related posts.
#}
{% set post = article.post %}

{# Search settings (Référencement) first, then the content: doc/seo.md #}
{% block title %}{{ post.seoTitle ?: post.title }}{% endblock %}
{% block description %}{{ post.seoDescription ?: (post.excerpt ?: post.title)|u.truncate(160, '…', false) }}{% endblock %}
{% block robots %}{{ not preview and not post.noIndex and post.visibility.value == 'public' ? parent() : 'noindex, follow' }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}{% set picture = post.seoImage ?? post.cover %}{{ picture ? absolute_url(image_url(picture, 'wide')) : parent() }}{% endblock %}
{% block head_meta %}
    {% if post.publishedAt %}<meta property="article:published_time" content="{{ post.publishedAt|date('c', 'Europe/Paris') }}">{% endif %}
    <meta property="article:modified_time" content="{{ post.updatedAt|date('c', 'Europe/Paris') }}">
    {% if post.category %}<meta property="article:section" content="{{ post.category.name }}">{% endif %}
{% endblock %}
{% block structured_data %}
    {{ json_ld([
        seo_article(post, post.seoTitle ?: post.title, post.seoDescription ?: (post.excerpt ?: post.title)|u.truncate(160, '…', false)),
        seo_breadcrumb([{label: 'Accueil', href: path('app_home')}, {label: 'Actualités', href: path('app_post_index')}, {label: post.title, href: path('app_post_show', {slug: post.slug})}]),
        ...seo_blocks(url('app_post_show', {slug: post.slug}), article.body, article.aside, article.outro),
    ]) }}
{% endblock %}

{% block body %}
    {% if preview %}
        {# Preview from the editor: what is not on the site yet, the content or only its changes #}
        <p class="p-article__preview" role="status">
            {%- if post.published -%}
                Aperçu des modifications non enregistrées : l’article en ligne n’a pas changé.
            {%- else -%}
                Aperçu : cet article n’est pas publié{% if post.publishedAt %} (publication prévue le {{ post.publishedAt|format_datetime('long', 'short', locale: 'fr') }}){% endif %}.
            {%- endif -%}
        </p>
    {% endif %}

    <article class="p-article">
        {{ include('post/_header.html.twig', {post: post, readingMinutes: article.readingMinutes}) }}

        <div class="l-container p-article__reading-layout">
            <aside class="p-article__sidebar">
                {% if article.toc is not empty %}<twig:Content:Toc :entries="article.toc" />{% endif %}
                <twig:Content:Blocks :blocks="article.aside" />
            </aside>
            <div class="p-article__body" data-toc-content>
                <twig:Content:Blocks :blocks="article.body" />
            </div>
        </div>

        <twig:Content:Blocks :blocks="article.outro" />

        {% if post.keywords is not empty or post.author %}
            <div class="l-container p-article__reading-layout">
                <div class="p-article__body p-article__closing">
                    {% if post.keywords is not empty %}
                        <p class="p-article__keywords">
                            <span class="u-note">À retrouver dans</span>
                            {% for keyword in post.keywords %}<span class="c-keyword">{{ keyword }}</span>{% endfor %}
                        </p>
                    {% endif %}
                    {% if post.author and post.author.bio %}<twig:Content:AuthorCard :author="post.author" />{% endif %}
                </div>
            </div>
        {% endif %}
    </article>

    {% if article.related is not empty %}
        <twig:Layout:Section theme="warm" class="p-article__related" aria-labelledby="related-title">
            <div class="l-stack l-stack--lg">
                <header class="c-section-header c-section-header--with-aside u-full">
                    <div class="c-section-header__text">
                        <twig:Ui:Eyebrow>À lire entre deux vols</twig:Ui:Eyebrow>
                        <h2 class="c-heading c-heading--h2 p-article__related-title" id="related-title">Gardez l’envie de découvrir.</h2>
                    </div>
                    <div class="c-section-header__aside"><twig:Ui:Link href="{{ path('app_post_index') }}">Tous les articles</twig:Ui:Link></div>
                </header>
                <div class="l-rail">
                    {% for related in article.related %}
                        <twig:Card:Post :post="related" :readingMinutes="reading_minutes(related)" />
                    {% endfor %}
                </div>
            </div>
        </twig:Layout:Section>
    {% endif %}
{% endblock %}
