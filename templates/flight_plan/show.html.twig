{% extends 'base.html.twig' %}

{% block title %}Plan de vol {{ plan.code }}{% endblock %}
{% block description %}Les sessions du Club ePlaneur sur le plan de vol {{ plan.label }} et les traces de ses pilotes.{% endblock %}

{% block body %}
    <section class="p-flight p-flight-plan t-light">
        <div class="l-container p-flight__head">
            <div class="l-stack l-stack--sm">
                <twig:Ui:Link href="{{ path('app_session_index') }}">Toutes les sessions</twig:Ui:Link>
                <twig:Ui:Eyebrow>Plan de vol · Condor {{ plan.condorVersion }} · {{ plan.category }}</twig:Ui:Eyebrow>
                <twig:Ui:Heading level="1" size="h2">{{ plan.label }}</twig:Ui:Heading>
                {% if plan.gliders or plan.landscape %}<p class="p-flight__meta">{{ [plan.gliders ? 'Planeurs ' ~ plan.gliders : null, plan.landscape ? 'Scène ' ~ plan.landscape : null]|filter(v => v)|join(' · ') }}</p>{% endif %}
                <div class="l-cluster">
                    {% if plan.sheetUrl %}<twig:Ui:Button href="{{ plan.sheetUrl }}" variant="outline" size="sm" icon="arrow-up-right" target="_blank" rel="noopener">Fiche et fichiers sur eplaneur.fr</twig:Ui:Button>{% endif %}
                    {% if is_granted('SESSION_ORGANISE') %}<twig:Ui:Link href="{{ path('app_session_new', {plan: plan.label}) }}">Proposer une session sur ce plan de vol</twig:Ui:Link>{% endif %}
                </div>
                <p class="u-note">Le plan de vol, sa fiche technique et ses fichiers (.fpl, .tsk) sont dans la bibliothèque d’eplaneur.fr ; ici, ce que le club en a fait.</p>
            </div>
        </div>

        <div class="l-container p-session__results">
            <twig:Ui:Heading level="2" size="h3">{{ sessions|length }} {{ sessions|length > 1 ? 'sessions' : 'session' }} sur ce plan de vol</twig:Ui:Heading>
            {% if sessions is empty %}
                <p class="u-note">Le club n’a pas encore volé ce plan de vol en session.</p>
            {% else %}
                <figure class="c-data-table">
                    <div class="c-data-table__scroll" tabindex="0" role="region" aria-label="Sessions sur ce plan de vol">
                        <table>
                            <thead><tr><th scope="col">Date</th><th scope="col">Session</th><th scope="col">Pilotes</th><th scope="col">Vainqueur</th><th scope="col"><span class="u-visually-hidden">Détails</span></th></tr></thead>
                            <tbody>
                                {% for session in sessions %}
                                    {% set winner = session.results|first %}
                                    <tr>
                                        <td><time datetime="{{ session.date|date('Y-m-d') }}">{{ session.date|format_date('short', locale: 'fr') }}</time></td>
                                        <td>{{ session.dedicatedTo ? 'Dédiée · ' ~ session.dedicatedTo : 'Ouverte' }}</td>
                                        <td>{{ session.participantCount }}</td>
                                        <td>{% if app.user and winner %}{{ winner.player }}{% if winner.speed %} · {{ winner.speed|number_format(1, ',', ' ') }} km/h{% endif %}{% else %}—{% endif %}</td>
                                        <td><a href="{{ path('app_session_show', {id: session.id}) }}">Voir la session<span class="u-visually-hidden"> du {{ session.date|format_date('short', locale: 'fr') }}</span></a></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </figure>
            {% endif %}
        </div>

        {% if ranked %}
            <div class="p-session__tracks" data-controller="session-viewer" data-session-viewer-url-value="{{ path('app_flight_plan_data', {code: plan.code}) }}">
                <div class="l-container l-stack l-stack--xs">
                    <twig:Ui:Heading level="2" size="h3">Toutes les traces sur ce plan de vol</twig:Ui:Heading>
                    <p class="u-note">Les vols de toutes les sessions et ceux faits seuls : la course part du circuit pour chacun, comme une course contre des fantômes.</p>
                </div>
                {{ include('flight/_session_replay.html.twig', {session: ranked, ranking_title: 'Meilleurs temps sur ce plan de vol', align: 'task'}) }}
            </div>
        {% elseif not app.user %}
            <div class="l-container"><p><a href="{{ path('app_login', {_target_path: app.request.requestUri}) }}">Connectez-vous</a> pour voir les traces des pilotes sur ce plan de vol.</p></div>
        {% endif %}
    </section>
{% endblock %}
