{# Network sessions of the club: the coming ones, or the latest ones when none is announced yet. #}
{% set coming = upcoming_sessions(6) %}
{% set sessions = coming is not empty ? coming : recent_sessions(3) %}
<twig:Layout:Section theme="dark" id="vols">
    <div class="l-stack l-stack--lg">
        <twig:Layout:SectionHeader eyebrow="02 / {{ coming is not empty ? 'Les prochains vols' : 'Les derniers vols' }}" title="On se retrouve là-haut."
            lead="Chaque semaine, les pilotes du club volent le même circuit, dans la même météo, chacun depuis chez soi." class="u-full p-flights__header">
            <twig:block name="aside"><twig:Ui:Link href="{{ path('app_session_index') }}">Tous les vols en réseau</twig:Ui:Link></twig:block>
        </twig:Layout:SectionHeader>

        {% if sessions is empty %}
            <p class="u-note">Les sessions sont annoncées dans le groupe WhatsApp des vols du club.</p>
        {% else %}
            {% if coming is empty %}<p class="u-note">Pas encore de session annoncée sur le site : voici les dernières, avec leurs résultats.</p>{% endif %}
            <div class="l-rail">
                {% for session in sessions %}
                    {% set plan = session.flightPlan %}
                    <twig:Card:Session
                        day="{{ session.date|date('d') }}"
                        month="{{ session.date|format_date(pattern: 'MMM', locale: 'fr')|capitalize }}"
                        year="{{ session.date|date('Y') }}"
                        version="Condor {{ plan.condorVersion }}"
                        schedule="{{ session.date|format_date(pattern: 'EEEE', locale: 'fr')|capitalize }}{{ session.startTime ? ' · ' ~ session.startTime|date('H\\hi') ~ ' · heure de Paris' : '' }}"
                        title="{{ plan.title ?? plan.code }}"
                        level="{{ plan.category }}{{ session.dedicatedTo ? ' · session dédiée' : '' }}"
                        text="{{ plan.code }}{{ plan.gliders ? ' · planeurs ' ~ plan.gliders : '' }}{{ plan.landscape ? ' · scène ' ~ plan.landscape : '' }}{{ coming is empty ? ' · ' ~ session.participantCount ~ ' pilotes' : '' }}"
                        href="{{ path('app_session_show', {id: session.id}) }}"
                        linkLabel="{{ coming is not empty ? 'Voir les détails du vol' : 'Voir les résultats' }}" />
                {% endfor %}
            </div>
        {% endif %}

        <div class="c-callout u-full">
            <p class="u-note">Premier vol en réseau ? On vous aide à vérifier les prérequis et à préparer votre connexion.</p>
            <div class="p-flights__tip-link"><twig:Ui:Link href="{{ path('app_page_show', {path: 'voler/vols-reseau/participer'}) }}">Préparer mon vol</twig:Ui:Link></div>
        </div>
    </div>
</twig:Layout:Section>
