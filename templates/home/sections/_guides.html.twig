{#
    "La technique, en clair": one card per version of Condor, its chapters pointing to the pages of the
    club that cover them (the installation page covers both versions).
#}
{% set guides = [
    {version: 2, chapters: [
        {label: 'Installer Condor et ses outils', href: path('app_page_show', {path: 'formation/bien-demarrer/installer-condor'})},
        {label: 'Ce qu’il faut pour voler avec Condor 2', href: path('app_page_show', {path: 'voler/vols-reseau/prerequis'}) ~ '#voler-avec-condor-2'},
        {label: 'Se connecter au serveur du club', href: path('app_page_show', {path: 'voler/vols-reseau/participer'}) ~ '#connexion-au-serveur-condor'},
        {label: 'Enregistrer et analyser son vol', href: path('app_page_show', {path: 'voler/enregistrer-vol'})},
    ]},
    {version: 3, chapters: [
        {label: 'Installer Condor et ses outils', href: path('app_page_show', {path: 'formation/bien-demarrer/installer-condor'})},
        {label: 'Ce qu’il faut pour voler avec Condor 3', href: path('app_page_show', {path: 'voler/vols-reseau/prerequis'}) ~ '#voler-avec-condor-3'},
        {label: 'Se connecter au serveur du club', href: path('app_page_show', {path: 'voler/vols-reseau/participer'}) ~ '#connexion-au-serveur-condor'},
        {label: 'Déposer sa trace et la revoir en 3D', href: path('app_flight_index')},
    ]},
] %}
<twig:Layout:Section theme="light" id="guides">
    <div class="l-stack l-stack--lg">
        <twig:Layout:SectionHeader eyebrow="04 / La technique, en clair" title="Moins de réglages. Plus de virages."
            lead="Deux versions, deux guides. Suivez celui qui correspond à votre simulateur." />
        <div class="l-grid l-grid--2 u-full">
            {% for guide in guides %}
                <twig:Card:Guide eyebrow="Installation / Configuration" title="Condor {{ guide.version }}"
                    text="De l’installation au premier vol en réseau : les bons réglages, sans prise de tête."
                    :chapters="guide.chapters" ctaLabel="Bien démarrer avec Condor {{ guide.version }}" ctaHref="{{ path('app_page_show', {path: 'formation/bien-demarrer'}) }}" />
            {% endfor %}
        </div>
        <nav class="l-grid l-grid--4 u-full c-link-bar" aria-label="Ressources complémentaires">
            <twig:Ui:Link href="{{ path('app_page_show', {path: 'formation/videos-pedagogiques'}) }}">Vidéos pédagogiques</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_page_show', {path: 'formation/bonnes-pratiques'}) }}">Bonnes pratiques</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_page_show', {path: 'voler/vols-reseau/prerequis'}) }}">Prérequis pour voler</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_page_show', {path: 'formation'}) }}">Toute la formation</twig:Ui:Link>
        </nav>
    </div>
</twig:Layout:Section>
