<twig:Layout:Section theme="accent" id="formation">
    <div class="l-stack l-stack--lg">
        <twig:Layout:SectionHeader eyebrow="03 / Du sol au ciel" title="Votre premier vol ? On y va pas à pas."
            lead="Pas besoin de tout maîtriser pour commencer. Juste d’avoir envie." />
        <div class="l-grid l-grid--3 l-grid--loose u-full">
            <twig:Card:Step number="01" title="Préparer le cockpit" linkLabel="Installer Condor"
                text="Installez Condor 2 ou 3, réglez vos commandes et vérifiez les prérequis. On vous explique tout." />
            <twig:Card:Step number="02" title="Prendre confiance" linkLabel="Suivre le parcours guidé"
                text="Un parcours guidé et des vidéos pédagogiques pour apprendre les bases à votre rythme, sans pression." />
            <twig:Card:Step number="03" title="Voler ensemble" linkLabel="Participer à un vol"
                text="Choisissez une session compatible, préparez votre connexion et partagez votre premier vol avec le club." />
        </div>
        <p class="u-strong">Une question à une étape ? Le club est là pour vous aider.</p>
    </div>
</twig:Layout:Section>
