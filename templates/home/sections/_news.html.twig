{#
    "Ça bouge au club" (Figma "Accueil · Ça bouge au club"): the featured post, large, and the latest
    published posts (HomeController). Alone, the featured post spreads over the whole width.
#}
<twig:Layout:Section theme="light" id="actualites">
    <div class="l-stack l-stack--lg">
        <twig:Layout:SectionHeader eyebrow="06 / À lire entre deux vols" title="Ça bouge au club." class="u-full p-news__header">
            <twig:block name="aside"><twig:Ui:Link href="{{ path('app_post_index') }}">Toutes les actualités</twig:Ui:Link></twig:block>
        </twig:Layout:SectionHeader>

        {% if featured or latest is not empty %}
            <div class="l-rail p-news__rail{{ not featured ? ' p-news__rail--even' : (latest is empty ? ' p-news__rail--single') }}">
                {% if featured %}
                    <twig:Card:PostFeatured :post="featured" :readingMinutes="reading_minutes(featured)" layout="{{ latest is empty ? 'split' : 'stacked' }}" level="3" />
                {% endif %}
                {% for post in latest %}
                    <twig:Card:Post :post="post" :readingMinutes="reading_minutes(post)" dated class="c-card--outlined" />
                {% endfor %}
            </div>
        {% else %}
            <p class="u-full">Les premières actualités du club arrivent bientôt.</p>
        {% endif %}

        <p class="u-note">Visuels d’ambiance, pas des captures de Condor.</p>
    </div>
</twig:Layout:Section>
