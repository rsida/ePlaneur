<twig:Layout:Section theme="primary" id="carnet">
    <div class="l-stack l-stack--lg">
        <twig:Layout:SectionHeader eyebrow="05 / L’aventure continue au sol" title="Ce vol mérite une petite trace."
            lead="Déposez votre trace, revivez votre trajet et comparez vos vols avec ceux des membres. Pour le plaisir de progresser, pas seulement pour le score." class="u-full p-logbook__header">
            <twig:block name="aside"><twig:Ui:Link href="{{ path('app_flight_logbook') }}">Ouvrir mon carnet</twig:Ui:Link></twig:block>
        </twig:Layout:SectionHeader>

        <article class="c-card c-card--raised t-paper p-logbook__panel u-full">
            <div class="p-logbook__head">
                <div class="c-card__group">
                    <twig:Ui:Eyebrow>Mon carnet / Exemple de vol</twig:Ui:Eyebrow>
                    <twig:Ui:Heading level="3" size="h2" class="p-logbook__title">Mon vol au-dessus des Alpes</twig:Ui:Heading>
                    <p class="u-note">Condor 3 · 10 octobre 2026 · Exemple de vol</p>
                </div>
                <twig:Ui:Button href="{{ path('app_flight_index') }}">Déposer une trace</twig:Ui:Button>
            </div>

            <twig:Ui:Dropzone name="trace" title="Glissez votre fichier de trace ici, ou choisissez un fichier"
                hint="Retrouvez votre parcours après l’atterrissage." />

            <div class="p-logbook__analysis">
                <div>
                    <div class="p-logbook__map">
                        <img class="p-logbook__relief" src="{{ asset('images/home/logbook/relief.svg') }}" alt="">
                        <img class="p-logbook__trace" src="{{ asset('images/home/logbook/trace-compared.png') }}" alt="">
                        <img class="p-logbook__trace" src="{{ asset('images/home/logbook/trace-own.svg') }}" alt="Tracé illustratif du vol">
                        <span class="p-logbook__map-label">Parcours illustratif · Alpes</span>
                        <span class="p-logbook__map-start">Départ / arrivée</span>
                    </div>
                    <p class="p-logbook__legend">
                        <span class="p-logbook__legend-own">— Votre vol</span>
                        <span class="u-muted">– – Membre A</span>
                    </p>
                    <div class="l-grid p-logbook__stats">
                        <twig:Ui:Stat label="Distance" value="145,8" unit="km" />
                        <twig:Ui:Stat label="Durée" value="2 h 18" unit="en vol" />
                        <twig:Ui:Stat label="Altitude max." value="2 480" unit="m" />
                    </div>
                </div>

                <div class="l-stack p-logbook__compare">
                    <twig:Ui:Heading level="4" size="h2" class="p-logbook__compare-title">Même ciel, plusieurs parcours.</twig:Ui:Heading>
                    <p class="u-note">Comparez les distances et échangez sur vos choix de vol. Exemples fictifs.</p>
                    <twig:Ui:Tag variant="soft">Distance parcourue</twig:Ui:Tag>
                    <twig:Ui:Meter label="Votre vol" value="145,8 km" :percent="95.7" highlight />
                    <twig:Ui:Meter label="Membre A" value="152,4 km" :percent="100" />
                    <twig:Ui:Meter label="Membre B" value="138,2 km" :percent="90.7" />
                    <twig:Ui:Link href="#">Comparer avec les membres</twig:Ui:Link>
                </div>
            </div>

            <div class="p-logbook__help">
                <twig:Ui:Link href="#">Comprendre ma trace</twig:Ui:Link>
                <twig:Ui:Link href="#">Créer mon carnet de vol</twig:Ui:Link>
            </div>
        </article>

        <p class="u-note">Trajet, statistiques et comparaisons fictifs, non issus des vols des membres. Proposition visuelle, sans dépôt de fichier actif.</p>

        {% if replay %}
            {% set pilot = replay.competitionId ?: replay.pilot %}
            <figure class="p-home-replay t-paper u-full" data-controller="home-replay"
                    data-home-replay-url-value="{{ path('app_flight_replay', {id: replay.id}) }}"
                    data-home-replay-label-value="{{ pilot }}">
                <div class="p-home-replay__map" data-home-replay-target="map" role="img" aria-label="Le vol de {{ pilot }} rejoué en 3D au-dessus du relief">
                    <p class="p-home-replay__status" data-home-replay-target="status">Chargement du vol…</p>
                </div>
                <figcaption class="p-home-replay__caption">
                    <span class="l-stack l-stack--xs">
                        <strong>En l’air avec {{ replay.owner ? replay.owner.publicName : replay.pilot }}</strong>
                        <span class="u-note">{{ replay.flightPlan ?? replay.glider }} · {{ replay.distance|flight_distance }} · {{ replay.duration|flight_duration }}{% if replay.taskSpeed %} · {{ replay.taskSpeed|number_format(1, ',', ' ') }} km/h{% endif %} · rejoué 60 fois plus vite</span>
                    </span>
                    <span class="l-cluster">
                        <button type="button" class="c-button c-button--outline c-button--sm" data-home-replay-target="toggle" data-action="home-replay#toggle">Pause</button>
                        <twig:Ui:Link href="{{ path('app_flight_show', {id: replay.id}) }}">Voir le vol en détail</twig:Ui:Link>
                    </span>
                </figcaption>
            </figure>
        {% endif %}

        {% if public_flights is not empty %}
            <section class="l-stack l-stack--sm u-full" aria-labelledby="public-flights-title">
                <twig:Ui:Heading level="3" size="h3" id="public-flights-title">Des vols de membres, à revivre</twig:Ui:Heading>
                <ul class="p-home-flights">
                    {% for flight in public_flights %}
                        <li>
                            <a class="c-card c-card--raised t-paper p-home-flights__card" href="{{ path('app_flight_show', {id: flight.id}) }}">
                                <span class="c-card__body l-stack l-stack--xs">
                                    <twig:Ui:Eyebrow>{{ [flight.simulator, flight.landscape]|filter(v => v)|join(' · ') }}</twig:Ui:Eyebrow>
                                    <strong class="p-home-flights__pilot">{{ flight.pilot }}{% if flight.competitionId %} · {{ flight.competitionId }}{% endif %}</strong>
                                    <span class="u-note">{{ flight.flightPlan ?? flight.glider }}</span>
                                    <span class="p-home-flights__values">{{ flight.distance|flight_distance }} · {{ flight.duration|flight_duration }}{% if flight.taskSpeed %} · {{ flight.taskSpeed|number_format(1, ',', ' ') }} km/h{% endif %}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
</twig:Layout:Section>
