{# Background video on large screens only (hero-video controller): phones keep the image. #}
<section class="p-hero t-dark" aria-labelledby="hero-title" data-controller="hero-video"
    data-hero-video-src-value="{{ asset('videos/home/hero.mp4') }}" data-hero-video-media-value="(width >= 64em)"
    data-hero-video-legend-value="Vidéo · Planeurs en vol sur Condor 3">
    <div class="p-hero__media" data-hero-video-target="media">
        <img src="{{ asset('images/home/hero.jpg') }}" alt="" fetchpriority="high">
        <video muted loop playsinline preload="none" aria-hidden="true" data-hero-video-target="video"></video>
    </div>
    <div class="p-hero__veil" aria-hidden="true"></div>

    <div class="l-container">
        <div class="l-stack p-hero__content">
        <twig:Ui:Eyebrow class="p-hero__eyebrow">Le club du planeur virtuel</twig:Ui:Eyebrow>
        <h1 id="hero-title" class="c-display">Prenez le large.<br>Ensemble.</h1>
        <p class="c-tagline">On se fait un vol ?</p>
        <p class="p-hero__text">Du premier virage à la grande traversée, volez avec une communauté qui vous accompagne. Sur Condor 2 et Condor 3, à votre rythme.</p>
        <div class="l-cluster">
            <twig:Ui:Button href="#rejoindre">Rejoindre le club</twig:Ui:Button>
            <twig:Ui:Button href="#club" variant="outline">Découvrir ePlaneur</twig:Ui:Button>
        </div>
        <p class="u-note u-inherit-color">Tous les âges. Tous les niveaux. La même envie de ciel.</p>
        </div>
    </div>

    <div class="l-container p-hero__foot">
        <div class="p-hero__legend">
            <p class="c-tagline c-tagline--plain">L’horizon n’attend que vous.</p>
            <div class="p-hero__credit">
                <p class="u-note" data-hero-video-target="legend">Image d’ambiance · Pas une capture de Condor</p>
                <button type="button" class="p-hero__toggle" aria-pressed="false" hidden
                    data-hero-video-target="toggle" data-action="hero-video#toggle">
                    <twig:ux:icon name="pause" class="p-hero__toggle-pause" />
                    <twig:ux:icon name="play" class="p-hero__toggle-play" />
                    <span class="u-visually-hidden">Mettre la vidéo en pause</span>
                </button>
            </div>
        </div>
    </div>
</section>

{% set next = upcoming_sessions(1)|first %}
{% if next %}
    <section class="p-next-flight t-primary" aria-label="Prochain vol en réseau"
        data-controller="session-time" data-session-time-at-value="{{ next.startsAt|date('c') }}" data-session-time-timed-value="{{ next.startTime ? 'true' : 'false' }}">
        <div class="l-container p-next-flight__inner">
            <twig:Ui:Date day="{{ next.date|date('d') }}" :meta="[next.date|format_date(pattern: 'MMM y', locale: 'fr')|capitalize]">
                <span class="p-next-flight__time">{{ next.date|format_date(pattern: 'EEEE', locale: 'fr')|capitalize }}{{ next.startTime ? ' · ' ~ next.startTime|date('H\\hi') ~ ' · Paris' : '' }}</span>
                <span class="p-next-flight__time" data-session-time-target="local" hidden></span>
            </twig:Ui:Date>
            <div class="p-next-flight__session">
                <p class="c-badge c-badge--small p-next-flight__countdown" data-session-time-target="countdown" hidden></p>
                <p class="p-next-flight__title">{{ next.flightPlan.title ?? next.flightPlan.code }}</p>
                <p class="u-note">Condor {{ next.flightPlan.condorVersion }} · {{ next.flightPlan.category }} · {{ next.flightPlan.code }}</p>
            </div>
            <div class="p-next-flight__link l-stack l-stack--xs">
                <twig:Ui:Link href="{{ path('app_session_show', {id: next.id}) }}">Préparer la session</twig:Ui:Link>
                <twig:Ui:Link href="{{ path('app_session_ics', {id: next.id}) }}" icon="calendar">Ajouter à mon agenda</twig:Ui:Link>
            </div>
        </div>
    </section>
{% endif %}
