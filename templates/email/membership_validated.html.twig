{% extends 'email/_layout.html.twig' %}

{% block content %}
    <p>Bonjour {{ membership.firstName }},</p>
    <p>Votre adhésion au Club ePlaneur pour la saison {{ membership.season.year }} est validée : bienvenue parmi les membres ! Vous avez maintenant accès aux contenus réservés aux membres sur le site.</p>
    <p style="margin:24px 0;"><a href="{{ url('app_membership_certificate', {id: membership.id}) }}" style="display:inline-block;padding:14px 20px;border-radius:4px;background:#3e5d83;color:#ffffff;font-weight:700;text-decoration:none;">Mon attestation d’adhésion</a></p>
    <p>Pour rejoindre les groupes WhatsApp du club et le serveur Discord, demandez à un membre du bureau.</p>
{% endblock %}
