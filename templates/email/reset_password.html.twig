{% extends 'email/_layout.html.twig' %}

{% block content %}
    <p>Bonjour {{ user.displayName }},</p>
    <p>Une réinitialisation du mot de passe de votre compte a été demandée. Pour choisir un nouveau mot de passe :</p>
    <p style="margin:24px 0;"><a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="display:inline-block;padding:14px 20px;border-radius:4px;background:#3e5d83;color:#ffffff;font-weight:700;text-decoration:none;">Choisir un nouveau mot de passe</a></p>
    <p style="font-size:13px;color:#586772;">Ce lien est valable jusqu’au {{ resetToken.expiresAt|date('d/m/Y à H:i', 'Europe/Paris') }} (heure de Paris). Si vous n’êtes pas à l’origine de cette demande, ignorez ce message : votre mot de passe ne change pas.</p>
{% endblock %}
