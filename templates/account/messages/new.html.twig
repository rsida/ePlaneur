{% extends 'account/_layout.html.twig' %}

{% set section = 'messages' %}
{% block title %}Nouveau message{% endblock %}
{% block heading %}Nouveau message{% endblock %}
{% block lead %}À un autre membre, au comité directeur ou aux administrateurs du site.{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'p-account__panel', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="c-form">
            {{ form_row(form.recipient) }}
            {% if flight %}
                <p class="u-note">À propos du vol <a href="{{ path('app_flight_show', {id: flight.id}) }}">{{ flight.flightPlan ?? flight.originalName }}</a> de {{ flight.pilot }}.</p>
            {% endif %}
            {{ form_row(form.subject) }}
            {{ form_row(form.body) }}
            <p class="u-note">Votre correspondant reçoit un e-mail s’il l’a accepté dans son profil, et répond ici. Un message au comité ou aux administrateurs est lu par chacun d’eux.</p>
            <div class="l-cluster">
                <twig:Ui:Button type="submit">Envoyer</twig:Ui:Button>
                <twig:Ui:Link href="{{ path('app_account_messages') }}">Annuler</twig:Ui:Link>
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
