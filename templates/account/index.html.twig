{% extends 'account/_layout.html.twig' %}

{#
    Dashboard of the member space (Figma frames "Tableau de bord": active member, registered without
    membership, new account, trainer).
#}
{% block title %}Mon compte{% endblock %}
{% block heading %}Bonjour {{ app.user.displayName|split(' ')|first }}.{% endblock %}
{% block lead %}{{ membership and membership.status.value == 'validated' ? 'Membre ' ~ membership.season.year ~ ' · ' : '' }}Vos vols, vos progrès et la vie du club, au même endroit.{% endblock %}

{% block content %}
    {% set next = open|filter(s => not membership or s.year > membership.season.year)|first %}

    {# Membership #}
    <section class="p-account__panel p-account__panel--tint p-account-membership" aria-labelledby="membership-title">
        {% if membership and membership.status.value == 'validated' and not next %}
            <twig:Ui:Tag variant="soft" class="p-account__membership p-account__membership--validated">{{ membership.season.label }} · Validée</twig:Ui:Tag>
            <div class="p-account__panel-head">
                <div class="l-stack l-stack--xs">
                    <twig:Ui:Heading level="2" size="h4" id="membership-title">Le ciel se partage.</twig:Ui:Heading>
                    <p class="u-note">Votre adhésion est valable jusqu’au {{ membership.season.endsOn|format_date('long', locale: 'fr') }}.</p>
                </div>
                <twig:Ui:Button href="{{ path('app_membership_certificate', {id: membership.id}) }}" variant="outline" size="sm" icon="">Mon attestation</twig:Ui:Button>
            </div>
        {% elseif membership and membership.status.value in ['requested', 'paid'] %}
            <twig:Ui:Tag variant="soft">{{ membership.season.label }} · {{ membership.status.label }}</twig:Ui:Tag>
            <div class="p-account__panel-head">
                <div class="l-stack l-stack--xs">
                    <twig:Ui:Heading level="2" size="h4" id="membership-title">{{ membership.status.value == 'paid' ? 'Le club valide votre adhésion' : 'Votre demande est enregistrée' }}</twig:Ui:Heading>
                    <p class="u-note">{{ membership.status.value == 'paid' ? 'Votre paiement est reçu : vous recevrez un e-mail de bienvenue à la validation.' : 'Il reste à régler votre adhésion de ' ~ membership.total|euros ~ '.' }}</p>
                </div>
                <twig:Ui:Button href="{{ path('app_account_membership') }}" size="sm" icon="">Suivre ma demande</twig:Ui:Button>
            </div>
        {% elseif next %}
            <twig:Ui:Tag variant="soft">{{ next.label }} · Adhésions ouvertes</twig:Ui:Tag>
            <div class="p-account__panel-head">
                <div class="l-stack l-stack--xs">
                    <twig:Ui:Heading level="2" size="h4" id="membership-title">{{ membership ? 'Renouvelez votre adhésion' : 'Rejoignez le club' }}</twig:Ui:Heading>
                    <p class="u-note">
                        {% for type in next.types %}{{ type.name }} {{ type.price|euros }}{{ not loop.last ? ' · ' : '' }}{% endfor %}.
                        L’adhésion ouvre les contenus et les outils réservés aux membres, et soutient le club.
                    </p>
                </div>
                <twig:Ui:Button href="{{ path('app_account_membership') }}" size="sm" icon="">{{ membership ? 'Renouveler' : 'Adhérer' }}</twig:Ui:Button>
            </div>
        {% else %}
            <twig:Ui:Heading level="2" size="h4" id="membership-title">Adhésion</twig:Ui:Heading>
            <p class="u-note">Les adhésions ne sont pas ouvertes en ce moment.</p>
        {% endif %}
    </section>

    {# Mon premier vol: until every step is done #}
    {% set firstFlight = first_flight(app.user) %}
    {% set firstDone = firstFlight|filter(d => d)|length %}
    {% if firstDone < firstFlight|length %}
        <section class="p-account__panel p-account__panel--tint" aria-labelledby="first-flight-title">
            <div class="p-account__panel-head">
                <twig:Ui:Heading level="2" size="h4" id="first-flight-title">Mon premier vol</twig:Ui:Heading>
                <twig:Ui:Link href="{{ path('app_first_flight') }}">Voir les étapes</twig:Ui:Link>
            </div>
            <twig:Ui:Meter label="{{ firstDone }} étape{{ firstDone > 1 ? 's' : '' }} faite{{ firstDone > 1 ? 's' : '' }} sur {{ firstFlight|length }}" :percent="(100 * firstDone / firstFlight|length)|round(0, 'floor')" />
        </section>
    {% endif %}

    {# Mon parcours: the step to work on #}
    {% set step = path_current_step(app.user) %}
    <section class="p-account__panel p-account__panel--tint" aria-labelledby="path-title">
        <div class="p-account__panel-head">
            <twig:Ui:Heading level="2" size="h4" id="path-title">Mon parcours</twig:Ui:Heading>
            <twig:Ui:Link href="{{ path('app_path') }}">Voir tout le parcours</twig:Ui:Link>
        </div>
        {% if step %}
            <p><strong>{{ step.step.step.title }}</strong></p>
            {% if step.items is not empty %}<twig:Ui:Meter label="{{ step.doneCount }} élément{{ step.doneCount > 1 ? 's' : '' }} fait{{ step.doneCount > 1 ? 's' : '' }} sur {{ step.items|length }}" :percent="step.percent" />{% endif %}
            <div><twig:Ui:Button href="{{ path('app_path_step', {number: step.step.number}) }}" size="sm">{{ step.doneCount > 0 ? 'Continuer l’étape' : 'Commencer l’étape' }}</twig:Ui:Button></div>
        {% else %}
            <p>Toutes les étapes ouvertes sont terminées : refaites les exercices pour battre vos records, les suivantes arrivent bientôt.</p>
        {% endif %}
        {% set earned = path_badges(app.user)|filter(b => b.tier) %}
        {% if earned is not empty %}
            <p class="u-note"><a href="{{ path('app_path') }}#badges">{{ earned|length }} badge{{ earned|length > 1 ? 's' : '' }} sur 8</a> : {{ earned|map(b => b.badge.label ~ ' (' ~ b.tier.label|lower ~ ')')|join(', ') }}.</p>
        {% endif %}
    </section>

    {# Coming network sessions #}
    {% set sessions = upcoming_sessions(2) %}
    {% if sessions is not empty %}
        <section class="l-stack l-stack--sm" aria-labelledby="sessions-title">
            <div class="p-account__panel-head">
                <twig:Ui:Heading level="2" size="h3" id="sessions-title">On se retrouve en vol</twig:Ui:Heading>
                <twig:Ui:Link href="{{ path('app_session_index') }}">Toutes les sessions</twig:Ui:Link>
            </div>
            <div class="p-sessions__upcoming">
                {% for session in sessions %}{{ include('session/_card.html.twig') }}{% endfor %}
            </div>
        </section>
    {% endif %}

    {# Latest flights #}
    <section class="l-stack l-stack--sm" aria-labelledby="flights-title">
        <div class="p-account__panel-head">
            <twig:Ui:Heading level="2" size="h3" id="flights-title">Vos derniers vols</twig:Ui:Heading>
            <twig:Ui:Button href="{{ path('app_flight_index') }}" size="sm" icon="">Déposer une trace</twig:Ui:Button>
        </div>
        {% if recent is empty %}
            <div class="p-account__panel">
                <twig:Ui:Heading level="3" size="h4">Votre premier vol vous attend</twig:Ui:Heading>
                <p>Après un vol dans Condor, déposez sa trace : le site la montre sur la carte et en 3D, analyse vos thermiques et vos transitions, et vous donne des conseils pour la suite.</p>
                <p class="u-note">Condor 3 : le fichier .ftr du dossier Documents › Condor3 › FlightTracks. Condor 2 : un export IGC.</p>
            </div>
        {% else %}
            <div class="p-account-flights">
                {% for flight in recent %}{{ include('account/_flight_card.html.twig') }}{% endfor %}
            </div>
            {% if count > 3 %}<twig:Ui:Link href="{{ path('app_account_flights') }}">Tous mes vols ({{ count }})</twig:Ui:Link>{% endif %}
        {% endif %}
    </section>

    {# Progression and advice #}
    {% if speeds is not empty or tip or training_path(app.user).validated > 0 %}
        <div class="p-account__cols">
            <section class="p-account__panel" aria-labelledby="rhythm-title">
                <twig:Ui:Heading level="2" size="h4" id="rhythm-title">À votre rythme</twig:Ui:Heading>
                {% if speeds|length > 1 %}
                    <div data-controller="logbook-chart" data-logbook-chart-points-value="{{ speeds|json_encode }}">
                        <figure class="p-flight__chart p-account-rhythm"><figcaption>Vitesse circuit · {{ speeds|length }} derniers circuits terminés (km/h)</figcaption><div data-logbook-chart-target="chart" data-series="taskSpeed"></div></figure>
                    </div>
                {% elseif speeds is not empty %}
                    <p>Premier circuit terminé à {{ speeds|first.taskSpeed|number_format(1, ',', ' ') }} km/h : la courbe apparaîtra au prochain.</p>
                {% else %}
                    <p class="u-note">La courbe de votre vitesse circuit apparaît dès deux circuits terminés.</p>
                {% endif %}
                {% if badges is not empty %}
                    <div class="l-cluster">{% for item in badges %}<twig:Ui:Tag variant="soft">{{ item.badge.label }}</twig:Ui:Tag>{% endfor %}</div>
                {% endif %}
                {% set training = training_path(app.user) %}
                <p class="p-account__training">
                    <strong>Parcours de formation :</strong>
                    {{ training.validated }} étape{{ training.validated > 1 ? 's' : '' }} sur 8{% if training.qualification %} · {{ training.qualification }}{% endif %}{% if training.current %} · en cours : {{ training.current.title }}{% endif %}
                </p>
                <twig:Ui:Link href="{{ path('app_account_logbook') }}">Voir mon carnet de vol</twig:Ui:Link>
            </section>
            {% if tip %}
                <section class="p-account__panel p-account__panel--sand" aria-labelledby="tip-title">
                    <twig:Ui:Heading level="2" size="h4" id="tip-title">Un conseil pour le prochain vol</twig:Ui:Heading>
                    {% if tip.advice.step %}<twig:Ui:Tag variant="soft">{{ tip.advice.step.title }}</twig:Ui:Tag>{% endif %}
                    <strong>{{ tip.advice.title }}</strong>
                    <p>{{ tip.advice.text }}</p>
                    <span class="u-note">Vol du {{ tip.flight.date|format_date('long', locale: 'fr') }}</span>
                    <twig:Ui:Link href="{{ path('app_flight_show', {id: tip.flight.id}) }}">Lire l’analyse et les conseils</twig:Ui:Link>
                </section>
            {% endif %}
        </div>
    {% endif %}

    {# Trainers: flights waiting for a comment #}
    {% if to_comment is not empty %}
        <section class="p-account__panel" aria-labelledby="trainer-title">
            <twig:Ui:Heading level="2" size="h4" id="trainer-title">Pilotes suivis · vols à commenter</twig:Ui:Heading>
            <ul class="p-account-list">
                {% for flight in to_comment %}
                    <li>
                        <a href="{{ path('app_flight_show', {id: flight.id}) }}">{{ flight.pilot }}{% if flight.competitionId %} ({{ flight.competitionId }}){% endif %}</a>
                        <span class="u-note">{{ flight.flightPlan ? flight.flightPlan|flight_plan_name : flight.originalName }} · {{ flight.date|format_date('medium', locale: 'fr') }}{% if flight.taskSpeed %} · {{ flight.taskSpeed|number_format(1, ',', ' ') }} km/h{% endif %}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# News #}
    <section class="p-account__panel" aria-labelledby="news-title">
        <twig:Ui:Heading level="2" size="h4" id="news-title">Du nouveau au sol</twig:Ui:Heading>
        {% if comments is empty %}
            <p class="u-note">Aucun commentaire sur vos vols pour l’instant. Les formateurs peuvent commenter un vol entier ou un instant précis : vous serez prévenu par e-mail si vous l’avez choisi dans votre profil.</p>
        {% else %}
            <ul class="p-account-list">
                {% for comment in comments %}
                    <li>
                        <a href="{{ path('app_flight_show', {id: comment.flight.id}) }}{{ comment.at is not null ? '#t=' ~ comment.at : '#commentaires' }}">{{ comment.author ? comment.author.displayName : 'Compte supprimé' }} a commenté votre vol {{ comment.flight.flightPlan ? comment.flight.flightPlan|flight_plan_name : '' }}{% if comment.at is not null %} à {{ comment.at|flight_clock }}{% endif %}</a>
                        <span class="u-note">{{ comment.createdAt|format_date('medium', locale: 'fr') }} · « {{ comment.body|u.truncate(110, '…') }} »</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <nav class="p-account__panel p-account__panel--sand" aria-label="Raccourcis">
        <div class="p-account__links">
            <twig:Ui:Link href="{{ path('app_session_index') }}">Sessions en réseau</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_flight_records') }}">Records du club</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_flight_index') }}">Analyse de vols</twig:Ui:Link>
            <twig:Ui:Link href="{{ path('app_account_classes') }}">{{ is_granted('CLASS_TEACH') or account_in_class() ? 'Mes classes' : 'Classes du BIA' }}</twig:Ui:Link>
            {% if is_granted('ACTIVITY_VIEW') %}<twig:Ui:Link href="{{ path('app_activity') }}">Activité du club</twig:Ui:Link>{% endif %}
            <twig:Ui:Link href="{{ path('app_account_contact') }}">Contacter le club</twig:Ui:Link>
        </div>
    </nav>
{% endblock %}
