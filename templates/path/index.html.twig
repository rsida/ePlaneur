{% extends 'base.html.twig' %}

{% set mine = app.user is not null %}
{% set done = steps|filter(s => s.state.value == 'done')|length %}
{% set qualification = null %}
{% for s in steps|filter(s => s.state.value == 'done' and s.step.step.qualification) %}{% set qualification = s.step.step.qualification %}{% endfor %}

{% block title %}{{ mine ? 'Mon parcours' : 'Le parcours de formation' }}{% endblock %}
{% block description %}Huit étapes pour apprendre le vol en planeur sur le simulateur Condor : lectures, exercices en vol, quiz et validations par les formateurs du Club ePlaneur.{% endblock %}

{% block body %}
    <twig:Layout:Section theme="light" class="p-path">
        <div class="l-stack l-stack--lg">
            <div class="l-stack l-stack--sm">
                <twig:Ui:Eyebrow>Formation ePlaneur</twig:Ui:Eyebrow>
                <twig:Ui:Heading level="1" size="h1">{{ mine ? 'Mon parcours' : 'Le parcours de formation' }}</twig:Ui:Heading>
                {% if mine %}
                    <p class="u-lead">
                        {{ done }} étape{{ done > 1 ? 's' : '' }} terminée{{ done > 1 ? 's' : '' }} sur 8
                        {%- if qualification %} · <strong>{{ qualification }}</strong>{% endif %}.
                        {% if current %}Prochaine étape : {{ current.step.title }}.{% endif %}
                    </p>
                {% else %}
                    <p class="u-lead">Du premier virage au vol en réseau : huit étapes, chacune faite de lectures, d’exercices en vol, de quiz et de validations par les formateurs du club. Terminez une étape pour débloquer la suivante.</p>
                    <div class="l-cluster">
                        <twig:Ui:Button href="{{ path('app_register') }}">Créer mon compte gratuit</twig:Ui:Button>
                        <twig:Ui:Button href="{{ path('app_login', {_target_path: path('app_path')}) }}" variant="outline" icon="">Me connecter</twig:Ui:Button>
                    </div>
                {% endif %}
            </div>

            <ol class="p-path__map" role="list">
                {% for view in steps %}
                    {% set state = view.state.value %}
                    <li class="p-path__stop p-path__stop--{{ state }}">
                        <span class="p-path__node" aria-hidden="true">
                            {% if state == 'done' %}<twig:ux:icon name="check" />{% elseif state in ['locked', 'closed'] %}<twig:ux:icon name="lock-keyhole" />{% else %}{{ view.step.number }}{% endif %}
                        </span>
                        <a class="p-path__card c-card t-paper" href="{{ path('app_path_step', {number: view.step.number}) }}">
                            <span class="c-card__body l-stack l-stack--xs">
                                <span class="p-path__card-head">
                                    <span class="u-note">Étape {{ view.step.number }}</span>
                                    {% if mine or state == 'closed' %}<twig:Ui:Tag variant="{{ state == 'done' ? 'soft' : (state == 'current' ? 'default' : 'muted') }}">{{ view.state.label }}</twig:Ui:Tag>{% endif %}
                                </span>
                                <strong class="p-path__title">{{ view.step.title }}</strong>
                                {% if view.step.step.qualification %}<span class="u-note">Qualification du club : {{ view.step.step.qualification }}</span>{% endif %}
                                {% if state != 'closed' %}
                                    {% if mine and view.items is not empty %}
                                        <twig:Ui:Meter label="{{ view.doneCount }} sur {{ view.items|length }}" :percent="view.percent" :highlight="state == 'done'" />
                                    {% elseif view.items is not empty %}
                                        <span class="u-note">{{ view.items|length }} élément{{ view.items|length > 1 ? 's' : '' }}</span>
                                    {% endif %}
                                {% endif %}
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ol>

            <section class="l-stack" id="badges" aria-labelledby="badges-title">
                <div class="l-stack l-stack--xs">
                    <twig:Ui:Heading level="2" size="h3" id="badges-title">{{ mine ? 'Mes badges' : 'Des badges à gagner' }}</twig:Ui:Heading>
                    <p class="u-note">Chaque badge a trois niveaux : bronze, argent et or. Ils récompensent surtout les bonnes habitudes du pilote : se poser sur un terrain, voler sans pénalité, voler avec le club, régulièrement.</p>
                </div>
                <ul class="p-path__badges" role="list">
                    {% for view in badges %}
                        {% set tier = view.tier %}
                        <li class="p-path-badge{{ tier ? ' p-path-badge--' ~ tier.value }}">
                            <span class="p-path-badge__medal" aria-hidden="true"><twig:ux:icon name="{{ view.badge.icon }}" /></span>
                            <span class="l-stack l-stack--xs">
                                <span class="p-path-badge__head">
                                    <strong>{{ view.badge.label }}</strong>
                                    {% if tier %}<span class="p-path-badge__tier">{{ tier.label }}</span>{% endif %}
                                </span>
                                <span class="u-note">{{ view.badge.description }}</span>
                                {% if not mine %}
                                    {% set thresholds = view.badge.thresholds %}
                                    <span class="u-note">Bronze à {{ thresholds[0] }}, argent à {{ thresholds[1] }}, or à {{ thresholds[2] }}.</span>
                                {% elseif view.nextTier %}
                                    <twig:Ui:Meter label="{{ view.badge.count(view.count) }}" value="{{ view.nextTier.label }} à {{ view.nextThreshold }}" :percent="view.percent" />
                                {% else %}
                                    <span class="u-note">{{ view.badge.count(view.count) }}</span>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </twig:Layout:Section>
{% endblock %}
