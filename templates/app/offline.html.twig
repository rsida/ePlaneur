{% extends 'base.html.twig' %}

{% block title %}Hors ligne{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <twig:Layout:Section theme="light">
        <div class="l-stack l-stack--md">
            <twig:Ui:Eyebrow>Pas de réseau</twig:Ui:Eyebrow>
            <twig:Ui:Heading level="1" size="h1">Vous êtes hors ligne</twig:Ui:Heading>
            <p class="u-lead">Le site du club a besoin d’Internet pour afficher vos vols, votre parcours et les sessions. Reconnectez-vous, puis réessayez.</p>
            <div><twig:Ui:Button href="{{ path('app_home') }}" icon="">Réessayer</twig:Ui:Button></div>
        </div>
    </twig:Layout:Section>
{% endblock %}
