{% extends 'base.html.twig' %}

{% block title %}Les planeurs de Condor{% endblock %}
{% block description %}Les planeurs du simulateur Condor : envergure, masses, charge alaire, finesse, taux de chute et polaire de chacun.{% endblock %}

{% block body %}
    <section class="p-flight p-glider t-light">
        <div class="l-container p-flight__head">
            <div class="l-stack l-stack--sm">
                <twig:Ui:Eyebrow>Condor 3</twig:Ui:Eyebrow>
                <twig:Ui:Heading level="1" size="h2">Les planeurs</twig:Ui:Heading>
                <p class="p-flight__meta">La fiche et la polaire de chaque planeur du simulateur, lues dans ses fichiers.</p>
            </div>
        </div>

        <div class="l-container p-glider__list">
            {% if gliders is empty %}
                <p class="u-note">Aucun planeur n’est encore enregistré.</p>
            {% else %}
                <figure class="c-data-table">
                    <div class="c-data-table__scroll" tabindex="0" role="region" aria-label="Planeurs de Condor">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Planeur</th>
                                    <th scope="col">Envergure</th>
                                    <th scope="col">Finesse max.</th>
                                    <th scope="col">Chute min.</th>
                                    <th scope="col">Charge alaire</th>
                                    <th scope="col">Eau</th>
                                    <th scope="col">Indice DAeC</th>
                                    <th scope="col">Traces du club</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in gliders %}
                                    {% set glider = row.glider %}
                                    <tr>
                                        <th scope="row"><a href="{{ path('app_glider_show', {name: glider.name}) }}">{{ glider.model }}</a> <span class="u-note">{{ glider.name }}</span></th>
                                        <td>{{ glider.span|number_format(glider.span == glider.span|round ? 0 : 1, ',', ' ') }} m</td>
                                        <td>{{ glider.bestGlide ? glider.bestGlide|number_format(0, ',', ' ') ~ (glider.bestGlideSpeed ? ' à ' ~ glider.bestGlideSpeed|number_format(0) ~ ' km/h' : '') : '—' }}</td>
                                        <td>{{ glider.minSink ? glider.minSink|number_format(2, ',', ' ') ~ ' m/s' : '—' }}</td>
                                        <td>{{ glider.minWingLoading|number_format(1, ',', ' ') }}{% if glider.maxWingLoading > glider.minWingLoading %} à {{ glider.maxWingLoading|number_format(1, ',', ' ') }}{% endif %} kg/m²</td>
                                        <td>{{ glider.waterBallast > 0 ? glider.waterBallast ~ ' L' : '—' }}</td>
                                        <td>{{ glider.handicap ?? '—' }}</td>
                                        <td>{{ row.flights }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </figure>
            {% endif %}
        </div>
    </section>
{% endblock %}
