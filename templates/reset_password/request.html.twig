{% extends 'layout/form_page.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}
{% block heading %}Mot de passe oublié{% endblock %}
{% block intro %}Indiquez l’adresse de votre compte : nous vous envoyons un lien pour choisir un nouveau mot de passe.{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'c-form', novalidate: 'novalidate'}}) }}
        {{ form_rest(form) }}
        <twig:Ui:Button type="submit" block>Envoyer le lien</twig:Ui:Button>
    {{ form_end(form) }}
{% endblock %}

{% block aside %}
    <twig:Ui:Link href="{{ path('app_login') }}">Retour à la connexion</twig:Ui:Link>
{% endblock %}
