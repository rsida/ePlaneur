{#
    Numbered step of a path.
    <twig:Card:Step number="01" title="Préparer le cockpit" text="..." linkLabel="Installer Condor" href="#" />
#}
{% props number, title, text = null, linkLabel = null, href = '#' %}
<article {{ attributes.defaults({class: 'c-step'}) }}>
    <span class="c-step__number" aria-hidden="true">{{ number }}</span>
    <twig:Ui:Heading level="3" size="h3" class="c-step__title">{{ title }}</twig:Ui:Heading>
    {% if text %}<p class="c-step__text">{{ text }}</p>{% endif %}
    {% if linkLabel %}<twig:Ui:Link href="{{ href }}">{{ linkLabel }}</twig:Ui:Link>{% endif %}
</article>
