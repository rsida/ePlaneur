{#
    Article card: picture, category, title, excerpt, reading time and link.
    <twig:Card:Post :post="post" readingMinutes="7" />
#}
{% props post, readingMinutes = null %}
{% set cover = post.cover %}
<article {{ attributes.defaults({class: 'c-card c-post-card t-paper'}) }}>
    {% if cover %}<img class="c-post-card__media" src="{{ image_url(cover, 'card') }}" alt="" loading="lazy">{% endif %}
    <div class="c-card__body">
        {% if post.category %}<p class="c-eyebrow">{{ post.category.name }}</p>{% endif %}
        <h3 class="c-post-card__title"><a href="{{ path('app_post_show', {slug: post.slug}) }}">{{ post.title }}</a></h3>
        <p class="c-post-card__excerpt">{{ post.excerpt|u.truncate(120, '…', false) }}</p>
        <div class="c-post-card__footer">
            {% if readingMinutes %}<span class="u-note">{{ readingMinutes }} min de lecture</span>{% endif %}
            <span class="c-post-card__more" aria-hidden="true">Lire l’article →</span>
        </div>
    </div>
</article>
