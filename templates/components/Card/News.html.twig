{#
    Editorial card with an optional picture on top. The featured post of the news has its own
    component (Card:PostFeatured).
    <twig:Card:News eyebrow="Formation" title="..." text="..." image="{{ asset('...') }}" href="#" />
#}
{% props eyebrow = null, title, text = null, image = null, imageAlt = '', href = '#', linkLabel = 'Lire la suite' %}
<article {{ attributes.defaults({class: 'c-card c-card--outlined c-news t-paper'}) }}>
    {% if image %}
        <img class="c-news__media" src="{{ image }}" alt="{{ imageAlt }}" loading="lazy">
    {% endif %}
    <div class="c-card__body">
        {% if eyebrow %}<twig:Ui:Eyebrow>{{ eyebrow }}</twig:Ui:Eyebrow>{% endif %}
        <twig:Ui:Heading level="3" size="h3" class="c-news__title">{{ title }}</twig:Ui:Heading>
        {% if text %}<p class="c-card__text c-card__text--lead">{{ text }}</p>{% endif %}
        <div class="c-card__footer">
            <twig:Ui:Link href="{{ href }}">{{ linkLabel }}</twig:Ui:Link>
        </div>
    </div>
</article>
