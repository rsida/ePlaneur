{# Site footer: identity, link columns from the "footer" menu (level 1 = titles), legal line. #}
<footer {{ attributes.defaults({class: 'l-section c-footer t-dark'}) }}>
    <div class="l-container">
        <div class="c-footer__top">
            <div class="c-footer__intro">
                <twig:Ui:Logo />
                <p class="u-lead">Le plaisir du planeur en réseau. Une communauté pour apprendre, pratiquer et partager sur Condor 2 et Condor 3.</p>
                {% if app.user %}
                    <twig:Ui:Link href="{{ path('app_account') }}">Mon compte</twig:Ui:Link>
                {% else %}
                    <twig:Ui:Link href="{{ path('app_login') }}">Espace membre / Connexion</twig:Ui:Link>
                {% endif %}
            </div>
            <nav class="c-footer__columns" aria-label="Liens utiles">
                {% for column in menu('footer') %}
                    <div>
                        <p class="c-footer__title">{% if column.href %}<a href="{{ column.href }}">{{ column.label }}</a>{% else %}{{ column.label }}{% endif %}</p>
                        <ul class="c-footer__links" role="list">
                            {% for link in column.children %}
                                <li><a href="{{ link.href ?? '#' }}"{% if link.external %} rel="noopener"{% endif %}>{{ link.label }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </nav>
        </div>
        <div class="c-footer__legal">
            <p class="c-footer__copyright">© {{ 'now'|date('Y') }} ePlaneur · Le ciel se partage.</p>
            <a href="{{ path('app_page_show', {path: 'mentions-legales'}) }}">Mentions légales</a>
            <a href="{{ path('app_page_show', {path: 'confidentialite'}) }}">Confidentialité</a>
        </div>
    </div>
</footer>
