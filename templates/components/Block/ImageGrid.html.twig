{% props placed %}
<div class="c-image-grid">
    {% for item in placed.block.images %}
        {% set image = media(item.mediaId) %}
        {% if image %}
            <figure class="c-block-figure">
                <img class="c-block-figure__img c-image-grid__img" src="{{ media_url(image) }}" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
                {% if item.caption or image.credit %}
                    <figcaption class="c-block-figure__caption">
                        {% if item.caption %}<span>{{ item.caption }}</span>{% endif %}
                        {% if image.credit %}<span>{{ image.credit }}</span>{% endif %}
                    </figcaption>
                {% endif %}
            </figure>
        {% endif %}
    {% endfor %}
</div>
