{# YouTube/Vimeo video: poster first, the player (and its cookies) only after a click (`video` controller). #}
{% props placed %}
{% set data = placed.block %}
{% set poster = media(data.posterId) %}
{% set embed = data.embedUrl %}
<figure class="c-video">
    <div class="c-video__player" data-controller="video" data-video-src-value="{{ embed }}" data-video-title-value="{{ data.title ?: 'Vidéo' }}">
        {% if poster %}<img class="c-video__poster" src="{{ image_url(poster, 'content') }}" alt="" loading="lazy">{% endif %}
        {% if embed %}
            <button type="button" class="c-video__play" data-action="video#play">
                <twig:ux:icon name="play" />
                <span class="u-visually-hidden">Lire la vidéo{% if data.title %} « {{ data.title }} »{% endif %}{% if data.provider %} ({{ data.provider }}){% endif %}</span>
            </button>
        {% else %}
            <a class="c-video__play" href="{{ data.url }}" rel="noopener">
                <twig:ux:icon name="play" />
                <span class="u-visually-hidden">Voir la vidéo</span>
            </a>
        {% endif %}
        {% if data.title or data.subtitle %}
            <div class="c-video__info">
                {% if data.title %}<p class="c-video__title">{{ data.title }}</p>{% endif %}
                {% if data.subtitle %}<p class="c-video__subtitle">{{ data.subtitle }}</p>{% endif %}
            </div>
        {% endif %}
    </div>
    <figcaption class="c-block-figure__caption">
        {% if data.caption %}<span>{{ data.caption }}</span>{% endif %}
        {% if data.provider %}<span>La vidéo est hébergée par {{ data.provider }} ; le lecteur se charge au clic.</span>{% endif %}
    </figcaption>
</figure>
