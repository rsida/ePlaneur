{# Links to go further: rows (title, description, arrow) or compact arrow links with a note. #}
{% props placed %}
{% set data = placed.block %}
{% if data.safeStyle == 'arrows' %}
    <div class="c-arrow-links">
        <ul class="c-arrow-links__list" role="list">
            {% for link in data.links %}
                <li><twig:Ui:Link href="{{ link.url|safe_url }}" rel="{{ link.url starts with 'http' ? 'noopener' : false }}">{{ link.title }}</twig:Ui:Link></li>
            {% endfor %}
        </ul>
        {% if data.note %}<p class="u-note">{{ data.note }}</p>{% endif %}
    </div>
{% else %}
    <ul class="c-link-list" role="list">
        {% for link in data.links %}
            {% set external = link.url starts with 'http' %}
            <li>
                <a class="c-link-list__item" href="{{ link.url|safe_url }}"{% if external %} rel="noopener"{% endif %}>
                    <span class="c-link-list__text">
                        <span class="c-link-list__title">{{ link.title }}</span>
                        {% if link.description %}<span class="c-link-list__description">{{ link.description }}</span>{% endif %}
                    </span>
                    <twig:ux:icon name="arrow-up-right" class="c-link-list__icon" />
                </a>
            </li>
        {% endfor %}
    </ul>
    {% if data.note %}<p class="u-note">{{ data.note }}</p>{% endif %}
{% endif %}
