{#
    Cards of the sub-pages (context `pages`, prepared by PagePresenter): title, excerpt, access tag of
    reserved pages, link labelled with the page's link label.
#}
{% props placed %}
{% set data = placed.block %}
{% set pages = placed.context.pages ?? [] %}
{% if pages is not empty %}
    <section class="c-page-cards"{% if data.eyebrow %} aria-labelledby="{{ placed.key }}-title"{% else %} aria-label="Pages de la rubrique"{% endif %}>
        {% if data.eyebrow %}<h2 class="c-eyebrow" id="{{ placed.key }}-title">{{ data.eyebrow }}</h2>{% endif %}
        <ul class="c-page-cards__list" role="list">
            {% for child in pages %}
                {% set access = access_label(child) %}
                <li class="c-page-card">
                    <h3 class="c-page-card__title">{{ child.title }}</h3>
                    {% if child.excerpt %}<p class="c-page-card__text">{{ child.excerpt }}</p>{% endif %}
                    {% if access %}<p class="c-page-card__access"><twig:Ui:Access>{{ access }}</twig:Ui:Access></p>{% endif %}
                    <twig:Ui:Link href="{{ path('app_page_show', {path: child.path}) }}" class="c-page-card__link">
                        {{- child.linkLabel ?: 'Découvrir' -}}<span class="u-visually-hidden"> : {{ child.title }}</span>
                    </twig:Ui:Link>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
