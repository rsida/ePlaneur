{# Closing band of an article: numbered like a section, listed in the table of contents. #}
{% props placed %}
{% set data = placed.block %}
<section class="c-takeaways t-primary" id="{{ placed.toc.anchor }}" aria-labelledby="{{ placed.key }}-title">
    <div class="c-takeaways__inner">
        <p class="c-eyebrow">{{ placed.toc.number }} / {{ data.eyebrow ?: data.tocTitle }}</p>
        <h2 class="c-takeaways__title" id="{{ placed.key }}-title">{{ data.title }}</h2>
        {% if data.text %}<p class="c-takeaways__text">{{ data.text }}</p>{% endif %}
        {% if data.points is not empty %}
            <ul class="c-takeaways__points" role="list">
                {% for point in data.points %}
                    <li><twig:ux:icon name="check" class="c-takeaways__check" /><span>{{ point }}</span></li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if data.ctaLabel and data.ctaUrl %}
            <twig:Ui:Button href="{{ data.ctaUrl }}" variant="accent" size="sm">{{ data.ctaLabel }}</twig:Ui:Button>
        {% endif %}
    </div>
</section>
