{% props placed %}
{% set data = placed.block %}
<figure class="c-data-table">
    <div class="c-data-table__scroll" tabindex="0" role="region" aria-label="{{ data.caption ?: 'Tableau' }}">
        <table>
            <thead>
                <tr>{% for header in data.headers %}<th scope="col">{{ header }}</th>{% endfor %}</tr>
            </thead>
            <tbody>
                {% for row in data.rows %}
                    <tr>
                        {% for cell in row %}
                            {% if loop.first %}<th scope="row">{{ cell }}</th>{% else %}<td>{{ cell }}</td>{% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if data.caption %}<figcaption class="c-block-figure__caption">{{ data.caption }}</figcaption>{% endif %}
</figure>
