{# Quoted passage of a reference text: title, text, reference ("Statuts V23 · Article 9"). #}
{% props placed %}
{% set data = placed.block %}
<figure class="c-excerpt">
    <figcaption class="c-excerpt__title"{{ edit_field(placed, 'title') }}>{{ data.title }}</figcaption>
    <blockquote class="c-excerpt__text"><p{{ edit_field(placed, 'text') }}>{{ data.text }}</p></blockquote>
    {% if data.reference %}<p class="c-excerpt__reference">{{ data.reference }}</p>{% endif %}
</figure>
