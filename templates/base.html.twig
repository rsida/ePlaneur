<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ePlaneur{% endblock %} · Club ePlaneur</title>
        <meta name="description" content="{% block description %}Le club du planeur virtuel : apprendre, pratiquer et partager le vol en planeur sur Condor 2 et Condor 3.{% endblock %}">
        <meta name="theme-color" content="#192630">
        <link rel="icon" href="{{ asset('icons/glider.svg') }}" type="image/svg+xml">

        {{ include('_fonts.html.twig') }}

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="u-skip-link" href="#main">Aller au contenu</a>
        <twig:Site:Header />
        <main id="main">
            {% block body %}{% endblock %}
        </main>
        <twig:Site:Footer />
    </body>
</html>
