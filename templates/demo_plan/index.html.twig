{% extends 'base.html.twig' %}

{#
    Script of an end-to-end demonstration of the site, for the administrators (doc/demo-plan.md): read
    from top to bottom, it visits every feature in the order of a pilot's journey, each step with
    where to click, what to show, what to say about its teaching purpose and a live link.
#}
{% block title %}Plan de la démonstration{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% set flight_url = showcase ? path('app_flight_show', {id: showcase.id}) : path('app_flight_index') %}
{% set session_url = session ? path('app_session_show', {id: session.id}) : path('app_session_index') %}
{% set session_compare_url = session ? path('app_session_compare', {id: session.id}) : path('app_session_index') %}
{% set plan_url = session ? path('app_flight_plan_show', {code: session.flightPlan.code}) : path('app_session_index') %}
{% set compare_url = showcase ? path('app_flight_compare_pick', {id: showcase.id}) : path('app_flight_index') %}
{% set glider_url = showcase and showcase.glider ? path('app_glider_show', {name: showcase.glider}) : path('app_glider_index') %}
{% set pilot_logbook_url = showcase and showcase.owner ? path('app_flight_logbook_pilot', {id: showcase.owner.id}) : path('app_account_logbook') %}
{% set exercise_url = exercise ? path('app_path_exercise', {id: exercise.id}) : path('app_path') %}
{% set quiz_url = quiz and quiz.step ? path('app_path_step', {number: quiz.step.number}) : path('app_path') %}

